:"round","strokeLinejoin":"round","className":"lucide lucide-house w-3.5 h-3.5","children":[["$","path","5wwlr5",{"d":"M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"}],["$","path","1d0kgt",{"d":"M3 10a2 2 0 0 1 .709-1.528l7-5.999a2 2 0 0 1 2.582 0l7 5.999A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"}],"$undefined"]}]," Home"]}],["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-right w-3 h-3","children":[["$","path","mthhwq",{"d":"m9 18 6-6-6-6"}],"$undefined"]}],["$","$L4",null,{"href":"/blog","className":"hover:text-[#C8A97E] transition-colors","children":"Blog"}],["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-right w-3 h-3","children":[["$","path","mthhwq",{"d":"m9 18 6-6-6-6"}],"$undefined"]}],["$","span",null,{"className":"text-white/80 truncate max-w-[200px] sm:max-w-none","children":"Kitchen Fitting Cost Per Unit UK: What to Budget"}]]}],["$","div",null,{"className":"inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-white/10 border border-white/10 text-[#C8A97E] text-xs mb-4","children":"kitchen fitting cost per unit uk"}],["$","h1",null,{"className":"font-display text-3xl sm:text-4xl lg:text-5xl font-bold text-white tracking-tight leading-tight","children":"Kitchen Fitting Cost Per Unit UK: What to Budget"}],["$","div",null,{"className":"flex items-center gap-2 text-white/50 text-sm mt-5","children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-calendar w-4 h-4","children":[["$","path","1cmpym",{"d":"M8 2v4"}],["$","path","4m81vk",{"d":"M16 2v4"}],["$","rect","1hopcy",{"width":"18","height":"18","x":"3","y":"4","rx":"2"}],["$","path","8toen8",{"d":"M3 10h18"}],"$undefined"]}],"31 July 2026",["$","span",null,{"className":"text-white/25","children":"·"}],["$","span",null,{"children":"BMB Renovation"}]]}]]}]}],["$","article",null,{"className":"py-14 sm:py-20 flex-grow bg-gray-50","children":["$","div",null,{"className":"max-w-[800px] mx-auto px-4 sm:px-6","children":["$","div",null,{"className":"bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10","children":[["$","div",null,{"children":[["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["Searching for the kitchen fitting cost per unit in the UK can give you a useful starting point, but it is not a complete quote. Kitchen installers may price by cabinet, by day, by room size or as one fixed project price. As a rough guide, standard kitchen cabinet installation labour may typically be around £150 to £300 per unit, while larger, rigid, tall or more complicated units may be around £250 to £500 or more. Every project differs, and these figures may exclude cabinets, worktops, appliances and additional trades; request a free, no-obligation quote from BMB Renovation for accurate pricing in its service areas."]}],["$","h2",null,{"className":"font-display text-2xl sm:text-3xl font-bold text-gray-900 tracking-tight mt-12 mb-4","children":"What does a kitchen fitting cost per unit include?"}],["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["A per-unit installation price may cover assembling or positioning the cabinet, securing it to the wall or floor, levelling it and fitting doors, drawer fronts and basic hardware. For a base unit, it may also include preparing the cabinet for a sink or appliance, although the exact scope should be confirmed before work starts. Wall units can require additional care where walls are uneven or fixings need strengthening. Tall larder, housing and integrated-appliance units can take longer because they need accurate alignment with neighbouring cabinets and surrounding finishes."]}],["$","ul",null,{"className":"my-5 space-y-2.5","children":[["$","li","0",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Standard base or wall cabinet installation: as a rough guide, typically around £150–£300 per unit for labour."]}]]}],["$","li","1",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Tall, larder or integrated appliance housing: as a rough guide, typically around £250–£500 or more per unit."]}]]}],["$","li","2",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Flat-pack furniture can require additional assembly time, particularly if parts are missing, damaged or difficult to align."]}]]}],["$","li","3",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Rigid or pre-assembled units may reduce assembly time on site, although installation requirements still vary."]}]]}],["$","li","4",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["These are broad UK guide prices, not fixed rates. Every project differs, and access, location, VAT and the agreed scope can change the final figure; request a free, no-obligation quote for accurate pricing."]}]]}]]}],["$","aside",null,{"className":"my-10 rounded-2xl bg-gradient-to-br from-gray-900 via-gray-800 to-gray-900 p-6 sm:p-8 border border-[#C8A97E]/30","children":[["$","h3",null,{"className":"font-display text-xl sm:text-2xl font-bold text-white tracking-tight mb-2","children":"Thinking about your own project?"}],["$","p",null,{"className":"text-white/70 text-sm sm:text-base leading-relaxed mb-5","children":["BMB Renovation covers Watford, Bushey, Rickmansworth, St Albans, Hemel Hempstead and beyond — all trades in-house. Call +44 7775 758 717 or send us a message."]}],["$","$L4",null,{"href":"/contact","className":"inline-flex items-center gap-2 px-6 py-3 rounded-full bg-[#C8A97E] text-white text-sm font-bold hover:bg-[#b39668] transition-colors","children":["Get a Free Quote",["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right w-4 h-4","children":[["$","path","1ays0h",{"d":"M5 12h14"}],["$","path","xquz4c",{"d":"m12 5 7 7-7 7"}],"$undefined"]}]]}]]}],["$","h2",null,{"className":"font-display text-2xl sm:text-3xl font-bold text-gray-900 tracking-tight mt-12 mb-4","children":"Why the number of units is not the whole story"}],["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["Multiplying a unit rate by the number of cupboards can make a quote appear straightforward, but kitchens contain several tasks that do not fit neatly into a per-unit calculation. Removing the old kitchen, protecting floors, assembling furniture, scribing panels, fitting plinths and installing end panels all take time. A small kitchen with difficult access can cost more to fit than a larger, open room. Similarly, a simple run of base cabinets may take less time than a U-shaped layout with multiple corners, a peninsula, tall housings and several integrated appliances."]}],["$","h3",null,{"className":"font-display text-xl sm:text-2xl font-bold text-gray-900 tracking-tight mt-8 mb-3","children":"Layout and access factors that affect labour"}],["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["The layout can have a significant effect on the final installation price. Corners need careful measuring and may require corner mechanisms or filler panels. Islands and peninsulas can involve extra units, decorative panels and service routes. Uneven floors and walls can mean more scribing and adjustment, particularly in older homes. Access also matters: stairs, restricted parking, long carrying distances and limited working space can add time without adding units. Ask whether the quotation includes delivery handling, rubbish removal, protection of existing areas and final adjustment of doors and drawers."]}],["$","h2",null,{"className":"font-display text-2xl sm:text-3xl font-bold text-gray-900 tracking-tight mt-12 mb-4","children":"How materials and cabinet type change the price"}],["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["The furniture itself can vary considerably in price, so it is important to separate the cost of the units from fitting labour. Basic melamine-faced cabinets and standard laminate doors may be more economical than painted timber, solid wood, framed, handleless or bespoke furniture. Delicate finishes may require slower installation and more care to avoid marking. Worktops create another distinction: laminate worktops can often be cut and fitted by the kitchen installer, while quartz, granite and some porcelain surfaces may need specialist templating and installation. Curved worktops, upstands, splashbacks and unusual cut-outs should be listed separately in the quote."]}],["$","ul",null,{"className":"my-5 space-y-2.5","children":[["$","li","0",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Cabinets and doors: check whether these are priced separately from fitting."]}]]}],["$","li","1",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Worktops: laminate, timber, compact laminate and stone can have different fitting requirements."]}]]}],["$","li","2",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Handles and hinges: confirm whether fitting is included, as upgraded mechanisms or push-to-open systems can add labour."]}]]}],["$","li","3",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Integrated appliances: allow for housing, ventilation, panels and connections individually."]}]]}],["$","li","4",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Splashbacks and tiling: these are often measured by area rather than by cabinet unit and may need a separate allowance."]}]]}]]}],["$","h2",null,{"className":"font-display text-2xl sm:text-3xl font-bold text-gray-900 tracking-tight mt-12 mb-4","children":"Additional trades that can change the final kitchen quote"}],["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["A kitchen replacement can involve more than cabinet installation. Moving a sink, dishwasher or washing machine may require plumbing and alterations to waste pipes. Changing the cooker position may involve electrical work, gas work by a suitably qualified professional where applicable, or changes to ventilation. New sockets, lighting, an extractor, flooring, plastering, decorating and tiling can all sit outside a basic per-unit fitting rate. If walls need repairing after the old cabinets are removed, that preparation should be priced before fitting begins. A clear quotation should show what is included, excluded and provisional."]}],["$","h3",null,{"className":"font-display text-xl sm:text-2xl font-bold text-gray-900 tracking-tight mt-8 mb-3","children":"Get comparable kitchen fitting quotes"}],["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["When comparing quotes, provide each installer with the same cabinet plan, unit count, appliance list and worktop specification. Ask for separate lines for removal, installation, plumbing, electrical work, tiling, flooring, decorating, delivery and waste disposal. Check whether prices include VAT and whether the installer is supplying materials or fitting items you have bought yourself. It is also sensible to ask who is responsible for measuring, checking appliance requirements and resolving damaged or missing parts. BMB Renovation provides kitchen fitting and renovation in Watford and its listed service areas, with plumbing, tiling, electrical and cabinet installation handled in-house. You can see more about ",["$","$L4","0",{"href":"/kitchen-renovation-watford","className":"text-[#C8A97E] font-medium underline decoration-[#C8A97E]/40 underline-offset-2 hover:decoration-[#C8A97E] transition-colors","children":"kitchen renovation in Watford"}]," or request a ",["$","$L4","1",{"href":"/contact","className":"text-[#C8A97E] font-medium underline decoration-[#C8A97E]/40 underline-offset-2 hover:decoration-[#C8A97E] transition-colors","children":"free, no-obligation quote"}],"."]}],["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["For homeowners in Bushey, Rickmansworth, St Albans, Hemel Hempstead, Borehamwood, Harrow, Croxley Green, Luton and Bedford, the most useful figure is usually the complete installed project cost rather than a single unit rate. A per-unit price can help compare the cabinet-fitting element, but the final budget should reflect the room’s condition, chosen materials, layout and every trade needed to make the kitchen functional. BMB Renovation is based at 157 Judge Street, Watford WD24 5AN and can be contacted on +44 7775 758 717 or contact@bmbrenovation.co.uk."]}],["$","aside",null,{"className":"my-10 rounded-2xl bg-gradient-to-br from-gray-900 via-gray-800 to-gray-900 p-6 sm:p-8 border border-[#C8A97E]/30","children":[["$","h3",null,{"className":"font-display text-xl sm:text-2xl font-bold text-white tracking-tight mb-2","children":"Get a Free, No-Obligation Quote"}],["$","p",null,{"className":"text-white/70 text-sm sm:text-base leading-relaxed mb-5","children":["BMB Renovation handles kitchens, bathrooms and full home renovations across Watford, Hertfordshire, North London & Bedfordshire — all trades in-house. Tell us about your project today."]}],["$","$L4",null,{"href":"/contact","className":"inline-flex items-center gap-2 px-6 py-3 rounded-full bg-[#C8A97E] text-white text-sm font-bold hover:bg-[#b39668] transition-colors","children":["Get My Free Quote",["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right w-4 h-4","children":[["$","path","1ays0h",{"d":"M5 12h14"}],["$","path","xquz4c",{"d":"m12 5 7 7-7 7"}],"$undefined"]}]]}]]}]]}],["$","section",null,{"className":"mt-14","children":[["$","div",null,{"className":"flex items-center gap-2.5 mb-6","children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle-help w-6 h-6 text-[#C8A97E]","children":[["$","circle","1mglay",{"cx":"12","cy":"12","r":"10"}],["$","path","1u773s",{