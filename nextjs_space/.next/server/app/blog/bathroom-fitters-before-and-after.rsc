th":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-house w-3.5 h-3.5","children":[["$","path","5wwlr5",{"d":"M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"}],["$","path","1d0kgt",{"d":"M3 10a2 2 0 0 1 .709-1.528l7-5.999a2 2 0 0 1 2.582 0l7 5.999A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"}],"$undefined"]}]," Home"]}],["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-right w-3 h-3","children":[["$","path","mthhwq",{"d":"m9 18 6-6-6-6"}],"$undefined"]}],["$","$L4",null,{"href":"/blog","className":"hover:text-[#C8A97E] transition-colors","children":"Blog"}],["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-right w-3 h-3","children":[["$","path","mthhwq",{"d":"m9 18 6-6-6-6"}],"$undefined"]}],["$","span",null,{"className":"text-white/80 truncate max-w-[200px] sm:max-w-none","children":"Bathroom Fitters Before and After: What to Expect"}]]}],["$","div",null,{"className":"inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-white/10 border border-white/10 text-[#C8A97E] text-xs mb-4","children":"bathroom fitters before and after"}],["$","h1",null,{"className":"font-display text-3xl sm:text-4xl lg:text-5xl font-bold text-white tracking-tight leading-tight","children":"Bathroom Fitters Before and After: What to Expect"}],["$","div",null,{"className":"flex items-center gap-2 text-white/50 text-sm mt-5","children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-calendar w-4 h-4","children":[["$","path","1cmpym",{"d":"M8 2v4"}],["$","path","4m81vk",{"d":"M16 2v4"}],["$","rect","1hopcy",{"width":"18","height":"18","x":"3","y":"4","rx":"2"}],["$","path","8toen8",{"d":"M3 10h18"}],"$undefined"]}],"6 August 2026",["$","span",null,{"className":"text-white/25","children":"·"}],["$","span",null,{"children":"BMB Renovation"}]]}]]}]}],["$","article",null,{"className":"py-14 sm:py-20 flex-grow bg-gray-50","children":["$","div",null,{"className":"max-w-[800px] mx-auto px-4 sm:px-6","children":["$","div",null,{"className":"bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10","children":[["$","div",null,{"children":[["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["Searching for bathroom fitters before and after photos can help you picture the difference a renovation may make. A tired bathroom can become brighter, easier to clean and more practical, but the finished image only shows part of the story. Behind the new tiles and fittings are decisions about layout, plumbing, ventilation, waterproofing, lighting, storage and the condition of the existing room. Understanding that work will help you compare examples realistically and plan an upgrade that suits your home, requirements and daily routine."]}],["$","h2",null,{"className":"font-display text-2xl sm:text-3xl font-bold text-gray-900 tracking-tight mt-12 mb-4","children":"What changes between the bathroom before and after?"}],["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["A convincing bathroom transformation is not always about making the room look luxurious. Often, the most useful improvements are better use of space, more reliable fittings and finishes that are easier to maintain. For example, replacing a bulky bath with a shower enclosure may improve movement in a compact room, while a wall-hung basin or fitted vanity can create useful storage without taking up much more floor area. In a larger bathroom, changing the position of the shower, toilet or basin may create a clearer layout, although moving services can add complexity to the work."]}],["$","h3",null,{"className":"font-display text-xl sm:text-2xl font-bold text-gray-900 tracking-tight mt-8 mb-3","children":"Typical before-and-after improvements"}],["$","aside",null,{"className":"my-10 rounded-2xl bg-gradient-to-br from-gray-900 via-gray-800 to-gray-900 p-6 sm:p-8 border border-[#C8A97E]/30","children":[["$","h3",null,{"className":"font-display text-xl sm:text-2xl font-bold text-white tracking-tight mb-2","children":"Thinking about your own project?"}],["$","p",null,{"className":"text-white/70 text-sm sm:text-base leading-relaxed mb-5","children":["BMB Renovation covers Watford, Bushey, Rickmansworth, St Albans, Hemel Hempstead and beyond — all trades in-house. Call +44 7775 758 717 or send us a message."]}],["$","$L4",null,{"href":"/contact","className":"inline-flex items-center gap-2 px-6 py-3 rounded-full bg-[#C8A97E] text-white text-sm font-bold hover:bg-[#b39668] transition-colors","children":["Get a Free Quote",["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right w-4 h-4","children":[["$","path","1ays0h",{"d":"M5 12h14"}],["$","path","xquz4c",{"d":"m12 5 7 7-7 7"}],"$undefined"]}]]}]]}],["$","ul",null,{"className":"my-5 space-y-2.5","children":[["$","li","0",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Old or damaged tiles replaced with a coordinated wall and floor finish."]}]]}],["$","li","1",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["A worn bath, basin or toilet replaced with modern fittings suited to the room."]}]]}],["$","li","2",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Poor storage improved with a vanity unit, mirrored cabinet, shelving or recessed storage where practical."]}]]}],["$","li","3",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Dull lighting upgraded to create better task lighting around the mirror and a more comfortable general light level."]}]]}],["$","li","4",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Leaking or awkward pipework addressed as part of the wider fitting work."]}]]}],["$","li","5",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["A dated colour scheme replaced with finishes that make the room feel cleaner, lighter or more spacious."]}]]}]]}],["$","h2",null,{"className":"font-display text-2xl sm:text-3xl font-bold text-gray-900 tracking-tight mt-12 mb-4","children":"The work bathroom fitters carry out behind the finished image"}],["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["The first stage is normally a survey and discussion of what you want to change. This should cover the room's dimensions, the position of existing services, access to the property, ventilation, storage needs and the products you have selected. It is worth checking measurements carefully before ordering sanitaryware or tiles, as a fitting that looks suitable online may be too large once clearances and door swings are considered."]}],["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["Once the room is stripped out, the condition of the substrate, walls, floor and pipework becomes clearer. Some bathrooms need only minor preparation, while others may reveal damp, uneven surfaces, outdated connections or damage around a previous leak. A clear quotation should state what is included and explain how unexpected work would be handled rather than assuming every room behind the old fittings is perfect."]}],["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["The installation itself may involve plumbing, electrical work, preparation, waterproofing, tiling, fitting cabinets and installing sanitaryware. These stages need to be coordinated: walls and floors should be prepared before tiling, tiles need time and care to finish properly, and final fittings should be protected from damage during the remaining work. BMB Renovation provides bathroom fitting and renovation across Watford, Bushey, Rickmansworth, St Albans, Hemel Hempstead, Borehamwood, Harrow, Croxley Green, Luton and Bedford. Its plumbing, tiling, electrical and cabinet installation work is handled in-house."]}],["$","h2",null,{"className":"font-display text-2xl sm:text-3xl font-bold text-gray-900 tracking-tight mt-12 mb-4","children":"How to judge bathroom fitters before-and-after examples"}],["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["Before-and-after photographs are useful, but they should be read as evidence of the type of work shown rather than a promise that your room will look identical. Look for images taken from similar angles, and compare the original room with the finished one. A wide-angle photograph can make a small bathroom appear much larger, while bright lighting and carefully styled accessories can hide practical details. Ask whether the example involved a simple replacement, a full strip-out or a change to the layout."]}],["$","ul",null,{"className":"my-5 space-y-2.5","children":[["$","li","0",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Was the room's layout changed, or were new fittings installed in the existing positions?"]}]]}],["$","li","1",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Are the tile lines, trims, silicone joints and edges neat when viewed closely?"]}]]}],["$","li","2",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Does the storage look large enough for the household's towels and toiletries?"]}]]}],["$","li","3",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Are the shower screen, basin, toilet and door positioned comfortably for everyday use?"]}]]}],["$","li","4",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Does the finish appear suitable for a high-moisture room, with sensible ventilation and easy-clean surfaces?"]}]]}],["$","li","5",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Can the fitter explain which preparation and installation stages produced the result?"]}]]}]]}],["$","h2",null,{"className":"font-display text-2xl sm:text-3xl font-bold text-gray-900 tracking-tight mt-12 mb-4","children":"Planning your own bathroom renovation"}],["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["Start with a practical list rather than choosing tiles first. Note what frustrates you about the current room: not enough storage, weak water pressure, a difficult-to-clean shower, poor lighting, cold flooring or a lack of usable space. Separate essential repairs from preferences, then decide whether the current layout is worth keeping. Retaining the positions of major services can simplify the work, while a new layout may be worthwhile if it solves a fundamental problem."]}],["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["Choose products that work together in scale and maintenance as well as appearance. Large-format tiles can reduce the number of grout joints, but they may require particularly flat walls and careful handling. Textured floor tiles can provide useful grip, although very deep textures may be harder to clean. A concealed cistern can create a streamlined look, but access for maintenance should still be considered. Ask about extraction, heating, lighting and electrical positions early, not after the tiles have been ordered."]}],["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["Allow time for product selection, delivery and decisions about finishes. A bathroom is a relatively small room, but several trades and materials must fit together precisely. You may also need to arrange temporary washing facilities, protect nearby floors and walls, and plan how waste will be removed from the property. If the home is occupied during the renovation, discuss working hours, water shut-offs, dust control and access before work begins. A detailed scope of work and written quotation can reduce misunderstandings about preparation, disposal, installation and finishing."]}],["$","h2",null,{"className":"font-display text-2xl sm:text-3xl font-bold text-gray-900 tracking-tight mt-12 mb-4","children":"Finding a bathroom fitting team in your area"}],["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["For homeowners in and around Watford, comparing a local team's process can be more useful than choosing from photographs alone. BMB Renovation is based at 157 Judge Street, Watford WD24 5AN, and offers free, no-obligation quotes for bathroom fitting and renovation. You can review the local service information for ",["$","$L4","0",{"href":"/bathroom-fitting-watford","className":"text-[#C8A97E] font-medium underline decoration-[#C8A97E]/40 underline-offset-2 hover:decoration-[#C8A97E] transition-colors","children":"bathroom fitting in Watford"}],", explore ",["$","$L4","1",{"href":"/bathroom-renovation-watford","className":"text-[#C8A97E] font-medium underline decoration-[#C8A97E]/40 underline-offset-2 hover:decoration-[#C8A97E] transition-colors","children":"bathroom renovation in Watford"}],", or view the ",["$","$L4","2",{"href":"/portfolio","className":"text-[#C8A97E] font-medium underline decoration-[#C8A97E]/40 underline-offset-2 hover:decoration-[#C8A97E] transition-colors","children":"recent projects"}]," page when considering the type of finish you want."]}],["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["Before appointing anyone, ask for a clear description of the proposed work, the products included, the preparation required and how variations will be agreed. Confirm who is responsible for plumbing, tiling, electrics, cabinet installation and final adjustments. The right questions at the start make it easier to compare like for like and help ensure that the attractive after photograph is supported by sound, practical work underneath."]}],["$","aside",null,{"className":"my-10 rounded-2xl bg-gradient-to-br from-gray-900 via-gray-800 to-gray-900 p-6 sm:p-8 border border-[#C8A97E]/30","children":[["$","h3",null,{"className":"font-display text-xl sm:text-2xl font-bold text-white tracking-tight mb-2","children":"Get a Free, No-Obligation Quote"}],["$","p",null,{"className":"text-white/70 text-sm sm:text-base leading-relaxed mb-5","children":["BMB Renovation handles kitchens, bathrooms and full home renovations across Watford, Hertfordshire, North London & Bedfordshire — all trades in-house. Tell us about your project today."]}],["$","$L4",null,{"href":"/contact","className":"inline-flex items-center gap-2 px-6 py-3 rounded-full bg-[#C8A97E] text-white text-sm font-bold hover:bg-[#b39668] transition-colors","children":["Get My Free Quote",["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right w-4 h-4","children":[["$","path","1ays0h",{"d":"M5 12h14"}],["$","path","xquz4c",{"d":"m12 5 7 7-7 7"}],"$undefined"]}]]}]]}]]}],["$","section",null,{"className":"mt-14","children":[["$","div",null,{"className":"flex items-center gap-2.5 mb-6","children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle-help w-6 h-6 text-[#C8A97E]","children":[["$","circle","1mglay",{"cx":"12","cy":"12","r":"10"}],["$","path","1u773s",{"d":"M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"}],["$","path","p32p05",{"d":"M12 17h.01"}],"$undefined"]}],["$","h2",null,{"className":"font-display text-2xl sm:text-3xl font-bold text-gray-900 tracking-tight","children":"Frequently Asked Questions"}]]}],["$","div",null,{"className":"space-y-3","children":[["$","details","0",{"className":"group bg-white rounded-xl border border-gray-100 shadow-sm open:border-[#C8A97E]/40","children":[["$","summary",null,{"className":"cursor-pointer list-none flex items-center justify-between gap-4 p-5 font-semibold text-gray-900 text-sm sm:text-base [&::-webkit-details-marker]:hidden","children":["How long does a bathroom renovation take?",["$","span",null,{"className":"text-[#C8A97E] text-xl leading-none group-open:rotate-45 transition-transform flex-shrink-0","children":"+"}]]}],["$","div",null,{"className":"px-5 pb-5 text-gray-600 text-sm leading-relaxed border-t border-gray-50 pt-4","children":["The timescale depends on the room's size, the amount of strip-out, the layout, product availability and any hidden repairs. A straightforward replacement is usually quicker than a full renovation involving moved plumbing or extensive preparation, so ask for a project-specific programme."]}]]}],["$","details","1",{"className":"group bg-white rounded-xl border border-gray-100 shadow-sm open:border-[#C8A97E]/40","children":[["$","summary",null,{"className":"cursor-pointer list-none flex items-center justify-between gap-4 p-5 font-semibold text-gray-900 text-sm sm:text-base [&::-webkit-details-marker]:hidden","children":["How much does bathroom fitting cost in the UK?",["$","span",null,{"className":"text-[#C8A97E] text-xl leading-none group-open:rotate-45 transition-transform flex-shrink-0","children":"+"}]]}],["$","div",null,{"className":"px-5 pb-5 text-gray-600 text-sm leading-relaxed border-t border-gray-50 pt-4","children":["Every project differs according to the fittings, tiles, labour, room condition and whether the layout changes. For accurate pricing, request a free, no-obligation quote from BMB Renovation and check whether preparation, waste removal and finishing are included."]}]]}],["$","details","2",{"className":"group bg-white rounded-xl border border-gray-100 shadow-sm open:border-[#C8A97E]/40","children":[["$","summary",null,{"className":"cursor-pointer list-none flex items-center justify-between gap-4 p-5 font-semibold text-gray-900 text-sm sm:text-base [&::-webkit-details-marker]:hidden","children":["Do bathroom fitters move plumbing and electrics?",["$","span",null,{"className":"text-[#C8A97E] text-xl leading-none group-open:rotate-45 transition-transform flex-shrink-0","children":"+"}]]}],["$","div",null,{"className":"px-5 pb-5 text-gray-600 text-sm leading-relaxed border-t border-gray-50 pt-4","children":["Many bathroom fitting teams can coordinate plumbing and electrical work, but the exact scope should be confirmed in writing. Moving services may affect the work programme, particularly where floors or walls need to be opened and repaired."]}]]}],["$","details","3",{"className":"group bg-white rounded-xl border border-gray-100 shadow-sm open:border-[#C8A97E]/40","children":[["$","summary",null,{"className":"cursor-pointer list-none flex items-center justify-between gap-4 p-5 font-semibold text-gray-900 text-sm sm:text-base [&::-webkit-details-marker]:hidden","children":["What should I ask bathroom fitters before hiring them?",["$","span",null,{"className":"text-[#C8A97E] text-xl leading-none group-open:rotate-45 transition-transform flex-shrink-0","children":"+"}]]}],["$","div",null,{"className":"px-5 pb-5 text-gray-600 text-sm leading-relaxed border-t border-gray-50 pt-4","children":["Ask what is included in the quotation, how unexpected defects are handled, who carries out each part of the work, how long the project is expected to take and what preparation you need to complete. It is also sensible to ask how the room will be protected and how waste will be removed."]}]]}]]}]]}],["$","section",null,{"className":"mt-14 pt-8 border-t border-gray-100","children":[["$","div",null,{"className":"flex items-center gap-2.5 mb-5","children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-wrench w-5 h-5 text-[#C8A97E]","children":[["$","path","cbrjhi",{"d":"M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"}],"$undefined"]}],["$","h2",null,