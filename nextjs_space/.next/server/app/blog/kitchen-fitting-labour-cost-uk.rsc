"$","rect","1hopcy",{"width":"18","height":"18","x":"3","y":"4","rx":"2"}],["$","path","8toen8",{"d":"M3 10h18"}],"$undefined"]}],"30 July 2026",["$","span",null,{"className":"text-white/25","children":"·"}],["$","span",null,{"children":"BMB Renovation"}]]}]]}]}],["$","article",null,{"className":"py-14 sm:py-20 flex-grow bg-gray-50","children":["$","div",null,{"className":"max-w-[800px] mx-auto px-4 sm:px-6","children":["$","div",null,{"className":"bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10","children":[["$","div",null,{"children":[["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["If you are budgeting for a new kitchen, the cabinets and appliances are only part of the cost. Kitchen fitting labour can make up a substantial share of the overall spend, particularly where the room needs electrical, plumbing, flooring or structural work. As a rough UK guide, straightforward installation labour may fall somewhere around £2,000 to £5,000, while a more involved kitchen renovation can cost considerably more. These figures are only broad indications: every project differs, and the room size, layout, specification, access and location all affect the final price. Request a free, no-obligation quote for accurate pricing. This guide explains what kitchen fitting labour usually covers, which extras increase the price and how to compare quotations properly."]}],["$","h2",null,{"className":"font-display text-2xl sm:text-3xl font-bold text-gray-900 tracking-tight mt-12 mb-4","children":"What is the typical kitchen fitting labour cost in the UK?"}],["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["Kitchen fitting is usually priced either as a fixed project quotation, a day rate, or a combination of both. As a rough UK guide, a kitchen fitter’s labour rate may be around £200 to £350 per day, although rates vary by location, trade and the complexity of the work. Every project differs, so request a free, no-obligation quote for accurate pricing. Some installers price per cabinet, but this can make comparisons difficult because cabinet sizes, fillers, end panels and alterations are not always treated in the same way. For a standard kitchen with an uncomplicated layout, fitting-only labour is often priced as a complete package rather than as a simple number of days."]}],["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["A basic installation could involve removing the old units, assembling and securing new cabinets, fitting doors and drawers, installing worktops, and making the final connections for appliances. A modest room with limited changes may take several working days. A larger kitchen, an island, bespoke storage, solid-surface worktops or a changed layout can take longer and require several trades. When requesting a quote, ask whether the price includes VAT and whether waste removal, delivery handling and finishing work are included."]}],["$","aside",null,{"className":"my-10 rounded-2xl bg-gradient-to-br from-gray-900 via-gray-800 to-gray-900 p-6 sm:p-8 border border-[#C8A97E]/30","children":[["$","h3",null,{"className":"font-display text-xl sm:text-2xl font-bold text-white tracking-tight mb-2","children":"Thinking about your own project?"}],["$","p",null,{"className":"text-white/70 text-sm sm:text-base leading-relaxed mb-5","children":["BMB Renovation covers Watford, Bushey, Rickmansworth, St Albans, Hemel Hempstead and beyond — all trades in-house. Call +44 7775 758 717 or send us a message."]}],["$","$L4",null,{"href":"/contact","className":"inline-flex items-center gap-2 px-6 py-3 rounded-full bg-[#C8A97E] text-white text-sm font-bold hover:bg-[#b39668] transition-colors","children":["Get a Free Quote",["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right w-4 h-4","children":[["$","path","1ays0h",{"d":"M5 12h14"}],["$","path","xquz4c",{"d":"m12 5 7 7-7 7"}],"$undefined"]}]]}]]}],["$","h3",null,{"className":"font-display text-xl sm:text-2xl font-bold text-gray-900 tracking-tight mt-8 mb-3","children":"What is normally included in a fitting quote?"}],["$","ul",null,{"className":"my-5 space-y-2.5","children":[["$","li","0",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Protection of suitable floors, nearby surfaces and access routes, where required."]}]]}],["$","li","1",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Removal of existing kitchen units, subject to the agreed scope of work."]}]]}],["$","li","2",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Assembly, levelling and fixing of base units, wall units, tall units and panels."]}]]}],["$","li","3",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Fitting doors, drawers, handles, plinths, cornices, pelmets and fillers."]}]]}],["$","li","4",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Installation and cutting of standard laminate worktops, if specified in the quotation."]}]]}],["$","li","5",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Fitting sinks, taps and appliances, with connections completed by the appropriate trades."]}]]}],["$","li","6",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Basic making-good, adjustment of doors and drawers, and a final check of the installation."]}]]}]]}],["$","h2",null,{"className":"font-display text-2xl sm:text-3xl font-bold text-gray-900 tracking-tight mt-12 mb-4","children":"Which extra tasks increase kitchen fitting labour costs?"}],["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["The biggest difference between a simple fitting job and a full renovation is the amount of preparation and alteration needed before the cabinets can be installed. Moving a sink, dishwasher, cooker or washing machine may require new plumbing and waste runs. Changing the position of an oven or adding appliances can mean new electrical circuits, additional sockets or changes to the consumer unit. Electrical work should be clearly identified in the quote and completed by an appropriately qualified professional."]}],["$","ul",null,{"className":"my-5 space-y-2.5","children":[["$","li","0",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Removing and disposing of old units, flooring, wall coverings or bulky appliances."]}]]}],["$","li","1",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Moving water, waste, gas or electrical services to suit a new layout."]}]]}],["$","li","2",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Installing extra sockets, lighting, extractor systems or appliance supplies."]}]]}],["$","li","3",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Repairing uneven walls, damaged plaster, floors or subfloors before fitting."]}]]}],["$","li","4",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Fitting tiles, splashbacks, new flooring, skirting boards or decorative finishes."]}]]}],["$","li","5",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Cutting and installing quartz, granite, porcelain or other specialist worktops."]}]]}],["$","li","6",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Building or removing partitions, widening openings, or carrying out structural alterations."]}]]}],["$","li","7",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Working in a difficult-to-access property where parking, stairs or restricted delivery space add time."]}]]}]]}],["$","h2",null,{"className":"font-display text-2xl sm:text-3xl font-bold text-gray-900 tracking-tight mt-12 mb-4","children":"Labour-only kitchen fitting versus a full renovation"}],["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["A labour-only quote assumes that you have bought the cabinets, panels, worktops, appliances and other materials. This can reduce the headline price, but you remain responsible for checking quantities, compatibility, delivery, missing parts and damaged items. If a required component is unavailable, the fitter may need to return on another day, potentially adding labour."]}],["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["A full kitchen renovation quote may coordinate several parts of the project, including plumbing, electrical work, cabinet installation, tiling, flooring and decorating. That can make the total easier to understand because the work is planned as one sequence. BMB Renovation provides kitchen fitting and renovation services, with plumbing, tiling, electrical and cabinet installation handled in-house. Homeowners in Watford can review the ",["$","$L4","0",{"href":"/kitchen-fitting-watford","className":"text-[#C8A97E] font-medium underline decoration-[#C8A97E]/40 underline-offset-2 hover:decoration-[#C8A97E] transition-colors","children":"kitchen fitting service in Watford"}]," or see the wider range of ",["$","$L4","1",{"href":"/kitchen-renovation-watford","className":"text-[#C8A97E] font-medium underline decoration-[#C8A97E]/40 underline-offset-2 hover:decoration-[#C8A97E] transition-colors","children":"kitchen renovation services"}]," before deciding what level of work is required."]}],["$","h2",null,{"className":"font-display text-2xl sm:text-3xl font-bold text-gray-900 tracking-tight mt-12 mb-4","children":"How to compare kitchen fitting quotes fairly"}],["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["The cheapest quotation is not necessarily the lowest-cost option if important tasks have been excluded. Give each contractor the same kitchen plan, product list and specification, then ask for an itemised quotation. It should separate labour, materials, specialist work and provisional sums wherever possible. Check whether the quote covers removal, waste, delivery, worktop templating, appliance connections, plumbing, electrics, tiling, flooring, decorating and final cleaning."]}],["$","ul",null,{"className":"my-5 space-y-2.5","children":[["$","li","0",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Confirm the exact work included and identify anything described only as ‘to be confirmed’."]}]]}],["$","li","1",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Check whether VAT is included and whether the price is fixed or based on an estimated number of days."]}]]}],["$","li","2",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Ask who supplies fixings, sealant, trim, adhesives, pipework and other small materials."]}]]}],["$","li","3",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Confirm responsibility for measuring and checking the kitchen before ordering."]}]]}],["$","li","4",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Ask how variations are approved if hidden damage or design changes are discovered."]}]]}],["$","li","5",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Check the expected start date, approximate duration and payment stages."]}]]}],["$","li","6",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Make sure specialist work, appliance connections and any relevant certification requirements are addressed."]}]]}],["$","li","7",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Compare the same specification rather than comparing totals from different scopes of work."]}]]}]]}],["$","h2",null,{"className":"font-display text-2xl sm:text-3xl font-bold text-gray-900 tracking-tight mt-12 mb-4","children":"Ways to keep kitchen fitting labour under control"}],["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["Keeping the existing layout is often one of the simplest ways to reduce labour because it may avoid moving plumbing, waste and electrical supplies. Ordering all cabinets and components in good time can also prevent delays, but do not arrange delivery until measurements and the final design have been checked. Keep a clear product schedule showing cabinet codes, panels, handles, appliances and worktop details. If the kitchen is being supplied by a separate retailer, ask the fitter to review the plan before you place the order."]}],["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["It is also worth deciding early whether you want a basic refresh or a complete renovation. Replacing doors and worktops may need less labour than removing every unit and changing the layout, although the condition of the existing cabinets matters. Conversely, cutting corners on preparation can lead to poor alignment, leaks, damaged surfaces or extra remedial work. A detailed survey and written scope are usually more useful than relying on a single headline fitting price. For a project in the Watford area, homeowners can request a ",["$","$L4","0",{"href":"/contact","className":"text-[#C8A97E] font-medium underline decoration-[#C8A97E]/40 underline-offset-2 hover:decoration-[#C8A97E] transition-colors","children":"free, no-obligation quote"}]," after discussing the room, layout and intended specification."]}],["$","aside",null,{"className":"my-10 rounded-2xl bg-gradient-to-br from-gray-900 via-gray-800 to-gray-900 p-6 sm:p-8 border border-[#C8A97E]/30","children":[["$","h3",null,{"className":"font-display text-xl sm:text-2xl font-bold text-white tracking-tight mb-2","children":"Get a Free, No-Obligation Quote"}],["$","p",null,{"className":"text-white/70 text-sm sm:text-base leading-relaxed mb-5","children":["BMB Renovation handles kitchens, bathrooms and full home renovations across Watford, Hertfordshire, North London & Bedfordshire — all trades in-house. Tell us about your project today."]}],["$","$L4",null,{"href":"/contact","className":"inline-flex items-center gap-2 px-6 py-3 rounded-full bg-[#C8A97E] text-white text-sm font-bold hover:bg-[#b39668] transition-colors","children":["Get My Free Quote",["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right w-4 h-4","children":[["$","path","1ays0h",{"d":"M5 12h14"}],["$","path","xquz4c",{"d":"m12 5 7 7-7 7"}],"$undefined"]}]]}]]}]]}],["$","section",null,{"className":"mt-14","children":[["$","div",null,{"className":"flex items-center gap-2.5 mb-6","children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle-help w-6 h-6 text-[#C8A97E]","children":[["$","circle","1mglay",{"cx":"12","cy":"12","r":"10"}],["$","path","1u773s",{"d":"M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"}],["$","path","p32p05",{"d":"M12 17h.01"}],"