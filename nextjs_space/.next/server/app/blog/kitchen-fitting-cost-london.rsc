 smoother renovation.\",\"datePublished\":\"2026-08-01T06:48:34.162Z\",\"dateModified\":\"2026-08-01T06:48:34.162Z\",\"author\":{\"@type\":\"Organization\",\"name\":\"BMB Renovation\",\"url\":\"https://bmbrenovation.co.uk\"},\"publisher\":{\"@type\":\"Organization\",\"name\":\"BMB Renovation\",\"url\":\"https://bmbrenovation.co.uk\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://bmbrenovation.co.uk/og-image.png\"}},\"mainEntityOfPage\":\"https://bmbrenovation.co.uk/blog/kitchen-fitting-cost-london\",\"keywords\":\"London kitchen installation cost, kitchen renovation cost London, kitchen fitting prices, kitchen labour costs, new kitchen budget\"}"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://bmbrenovation.co.uk\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Blog\",\"item\":\"https://bmbrenovation.co.uk/blog\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Kitchen Fitting Cost London: 2026 Price Guide\",\"item\":\"https://bmbrenovation.co.uk/blog/kitchen-fitting-cost-london\"}]}"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$2"}}],["$","$L3",null,{}],["$","section",null,{"className":"relative pt-28 pb-12 bg-gradient-to-br from-gray-900 via-gray-800 to-gray-900","children":["$","div",null,{"className":"max-w-[800px] mx-auto px-4 sm:px-6","children":[["$","nav",null,{"className":"flex items-center gap-1.5 text-xs text-white/50 mb-6","aria-label":"Breadcrumb","children":[["$","$L4",null,{"href":"/","className":"hover:text-[#C8A97E] transition-colors inline-flex items-center gap-1","children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"luci