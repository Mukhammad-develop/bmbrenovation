","path","4m81vk",{"d":"M16 2v4"}],["$","rect","1hopcy",{"width":"18","height":"18","x":"3","y":"4","rx":"2"}],["$","path","8toen8",{"d":"M3 10h18"}],"$undefined"]}],"2 August 2026",["$","span",null,{"className":"text-white/25","children":"·"}],["$","span",null,{"children":"BMB Renovation"}]]}]]}]}],["$","article",null,{"className":"py-14 sm:py-20 flex-grow bg-gray-50","children":["$","div",null,{"className":"max-w-[800px] mx-auto px-4 sm:px-6","children":["$","div",null,{"className":"bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10","children":[["$","div",null,{"children":[["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["Choosing kitchen fitters in Hemel Hempstead is not simply a matter of comparing the lowest headline price. A kitchen installation can involve cabinetry, worktops, plumbing, electrics, tiling, flooring, decorating and sometimes structural changes. The right fitter should explain what is included, identify potential problems before work starts and provide a quote that can be compared fairly with other estimates. This guide covers the main services, likely cost factors and practical questions to ask before appointing a contractor."]}],["$","h2",null,{"className":"font-display text-2xl sm:text-3xl font-bold text-gray-900 tracking-tight mt-12 mb-4","children":"What should you look for in a Hemel Hempstead kitchen fitter?"}],["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["Start by looking for a contractor who is clear about their scope of work. Ask whether they will fit units supplied by you, install a kitchen purchased through a retailer, or manage the full renovation from preparation through to finishing. These are different services, and a quote for cabinet installation alone should not be compared directly with one covering plumbing, tiling and decoration as well. It is also sensible to ask who will carry out each part of the work and whether different trades are coordinated by one person."]}],["$","h3",null,{"className":"font-display text-xl sm:text-2xl font-bold text-gray-900 tracking-tight mt-8 mb-3","children":"Questions worth asking before you appoint anyone"}],["$","aside",null,{"className":"my-10 rounded-2xl bg-gradient-to-br from-gray-900 via-gray-800 to-gray-900 p-6 sm:p-8 border border-[#C8A97E]/30","children":[["$","h3",null,{"className":"font-display text-xl sm:text-2xl font-bold text-white tracking-tight mb-2","children":"Thinking about your own project?"}],["$","p",null,{"className":"text-white/70 text-sm sm:text-base leading-relaxed mb-5","children":["BMB Renovation covers Watford, Bushey, Rickmansworth, St Albans, Hemel Hempstead and beyond — all trades in-house. Call +44 7775 758 717 or send us a message."]}],["$","$L4",null,{"href":"/contact","className":"inline-flex items-center gap-2 px-6 py-3 rounded-full bg-[#C8A97E] text-white text-sm font-bold hover:bg-[#b39668] transition-colors","children":["Get a Free Quote",["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right w-4 h-4","children":[["$","path","1ays0h",{"d":"M5 12h14"}],["$","path","xquz4c",{"d":"m12 5 7 7-7 7"}],"$undefined"]}]]}]]}],["$","ul",null,{"className":"my-5 space-y-2.5","children":[["$","li","0",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Will the quote include removal and disposal of the existing kitchen?"]}]]}],["$","li","1",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Who is responsible for checking measurements before units and worktops are ordered?"]}]]}],["$","li","2",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Are plumbing, electrical, tiling, flooring and decorating included or priced separately?"]}]]}],["$","li","3",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["What preparation is needed if walls or floors are uneven?"]}]]}],["$","li","4",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["How will changes, delays or unexpected defects be dealt with?"]}]]}],["$","li","5",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["What payment stages are proposed, and when will the work be considered complete?"]}]]}]]}],["$","h2",null,{"className":"font-display text-2xl sm:text-3xl font-bold text-gray-900 tracking-tight mt-12 mb-4","children":"Kitchen fitting services you may need"}],["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["A straightforward kitchen replacement may involve disconnecting appliances, removing old units, preparing the room, fitting cabinets and installing worktops. However, many Hemel Hempstead homeowners use the opportunity to improve the layout or update more than the cabinetry. Moving a sink, dishwasher or cooker can require changes to services, while a new layout may reveal the need for additional sockets, lighting or wall repairs. A detailed site visit can help identify these points before the scope and price are confirmed."]}],["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["Typical kitchen fitting and renovation services can include unit and worktop installation, appliance fitting, plumbing alterations, electrical work, tiling, flooring, plastering, painting and decorating. Some projects also include carpentry, such as adapting panels, boxing in pipework or creating bespoke storage. If you are considering a wider property project, a company that also handles ",["$","$L4","0",{"href":"/services","className":"text-[#C8A97E] font-medium underline decoration-[#C8A97E]/40 underline-offset-2 hover:decoration-[#C8A97E] transition-colors","children":"house renovation and related services"}]," may be able to coordinate connected work more efficiently."]}],["$","h3",null,{"className":"font-display text-xl sm:text-2xl font-bold text-gray-900 tracking-tight mt-8 mb-3","children":"Fitting a new kitchen or renovating the existing one?"}],["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["A full replacement is not always necessary. If the cabinet carcasses are sound, you may be able to retain them and replace doors, handles, worktops, splashbacks or appliances. This can reduce disruption, although it depends on the condition and compatibility of the existing units. Renovation is also worth considering where the main problem is dated decoration, poor lighting or worn flooring rather than the layout itself. Conversely, forcing new cabinets into an unsuitable arrangement can lead to compromises that are difficult to correct later."]}],["$","h2",null,{"className":"font-display text-2xl sm:text-3xl font-bold text-gray-900 tracking-tight mt-12 mb-4","children":"How much does kitchen fitting cost in Hemel Hempstead?"}],["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["As a rough UK guide, labour for a relatively uncomplicated kitchen installation may typically be in the region of £2,000 to £6,000, before the cost of cabinets, worktops, appliances and materials. A broader renovation involving plumbing, electrical changes, flooring, tiling or plastering can cost more. As a rough guide, a complete small or mid-sized kitchen project may typically run from around £8,000 to £25,000 or more, depending on the specification. These are broad indicative ranges rather than fixed local prices: every project differs, so request a free, no-obligation quote for accurate pricing."]}],["$","ul",null,{"className":"my-5 space-y-2.5","children":[["$","li","0",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["The size and shape of the room, including awkward corners and access restrictions."]}]]}],["$","li","1",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["The number and quality of cabinets, drawers, worktops and storage accessories."]}]]}],["$","li","2",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Whether appliances are freestanding, integrated or being relocated."]}]]}],["$","li","3",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["The condition of walls, floors, plumbing and electrical circuits."]}]]}],["$","li","4",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["The choice of worktop, flooring, tiles, splashback and decorative finishes."]}]]}],["$","li","5",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["The amount of preparation, removal, waste disposal and making-good required."]}]]}],["$","li","6",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Whether the project involves altering walls or other structural work."]}]]}]]}],["$","h2",null,{"className":"font-display text-2xl sm:text-3xl font-bold text-gray-900 tracking-tight mt-12 mb-4","children":"How to request an accurate kitchen fitting quote"}],["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["Give each fitter the same information so that the estimates are genuinely comparable. Share a basic floor plan, room measurements, photographs and details of the kitchen you have selected, if those decisions have already been made. Include appliance models or dimensions where possible, particularly for built-in ovens, hobs, extractors, dishwashers and American-style fridge freezers. If you are still choosing products, say so; a quote based on assumptions may need to change later."]}],["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["A site survey is useful before a final quote is accepted. The fitter can check access, wall and floor condition, existing service positions, ventilation, socket locations and the measurements needed for worktops. Ask for a written breakdown showing labour, materials, disposal, preparation and any provisional items. Clarify whether VAT applies, how long the estimate remains valid and what is excluded. If you are comparing options, you can ",["$","$L4","0",{"href":"/contact","className":"text-[#C8A97E] font-medium underline decoration-[#C8A97E]/40 underline-offset-2 hover:decoration-[#C8A97E] transition-colors","children":"request a free, no-obligation quote"}]," and provide the same project details for a more useful discussion."]}],["$","h2",null,