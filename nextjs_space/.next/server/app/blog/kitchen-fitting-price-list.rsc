ide lucide-house w-3.5 h-3.5","children":[["$","path","5wwlr5",{"d":"M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"}],["$","path","1d0kgt",{"d":"M3 10a2 2 0 0 1 .709-1.528l7-5.999a2 2 0 0 1 2.582 0l7 5.999A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"}],"$undefined"]}]," Home"]}],["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-right w-3 h-3","children":[["$","path","mthhwq",{"d":"m9 18 6-6-6-6"}],"$undefined"]}],["$","$L4",null,{"href":"/blog","className":"hover:text-[#C8A97E] transition-colors","children":"Blog"}],["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-right w-3 h-3","children":[["$","path","mthhwq",{"d":"m9 18 6-6-6-6"}],"$undefined"]}],["$","span",null,{"className":"text-white/80 truncate max-w-[200px] sm:max-w-none","children":"Kitchen Fitting Price List: UK Costs Explained"}]]}],["$","div",null,{"className":"inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-white/10 border border-white/10 text-[#C8A97E] text-xs mb-4","children":"kitchen fitting price list"}],["$","h1",null,{"className":"font-display text-3xl sm:text-4xl lg:text-5xl font-bold text-white tracking-tight leading-tight","children":"Kitchen Fitting Price List: UK Costs Explained"}],["$","div",null,{"className":"flex items-center gap-2 text-white/50 text-sm mt-5","children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-calendar w-4 h-4","children":[["$","path","1cmpym",{"d":"M8 2v4"}],["$","path","4m81vk",{"d":"M16 2v4"}],["$","rect","1hopcy",{"width":"18","height":"18","x":"3","y":"4","rx":"2"}],["$","path","8toen8",{"d":"M3 10h18"}],"$undefined"]}],"31 July 2026",["$","span",null,{"className":"text-white/25","children":"·"}],["$","span",null,{"children":"BMB Renovation"}]]}]]}]}],["$","article",null,{"className":"py-14 sm:py-20 flex-grow bg-gray-50","children":["$","div",null,{"className":"max-w-[800px] mx-auto px-4 sm:px-6","children":["$","div",null,{"className":"bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10","children":[["$","div",null,{"children":[["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["If you are comparing kitchen fitting quotes, a clear price list makes it easier to understand what you are actually paying for. The cost is rarely just cabinet installation: plumbing, electrics, worktops, appliances, tiling, flooring and waste removal can all affect the final figure. This guide gives rough UK guide prices for common kitchen fitting jobs, with labour and typical inclusions explained. Prices are indicative only: every project differs, local rates in Hertfordshire, North London and Bedfordshire can vary, and you should request a free quote for accurate pricing."]}],["$","h2",null,{"className":"font-display text-2xl sm:text-3xl font-bold text-gray-900 tracking-tight mt-12 mb-4","children":"Kitchen fitting price list: rough UK costs"}],["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["The figures below are broad guide prices for labour and standard installation work. They generally exclude the cost of new kitchen units, appliances, tiles, flooring and other supplied materials unless stated. A quote may also be affected by VAT, access, parking, the condition of the room and whether the work is completed as one coordinated project. Every project differs, so request a free quote for accurate pricing."]}],["$","ul",null,{"className":"my-5 space-y-2.5","children":[["$","li","0",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Remove an existing kitchen: as a rough guide, typically £300–£800. This may include taking out cabinets, worktops, a sink, tap and appliances, plus loading ordinary waste for disposal. Heavy materials, built-in appliances and difficult access can increase the price."]}]]}],["$","li","1",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Install flat-pack or assembled kitchen cabinets: as a rough guide, typically £1,000–£3,000 for a small to medium kitchen. This can cover levelling and securing base and wall units, fitting plinths, end panels and fillers, and adjusting doors and drawers. The number of units and the condition of the walls and floor are important factors."]}]]}],["$","li","2",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Fit worktops: as a rough guide, typically £300–£900 for standard laminate worktops. This may include measuring, cutting, joining, scribing to walls and making openings for a sink or hob. Solid wood, compact laminate, quartz, granite and other specialist worktops can cost more, particularly where templating or specialist fabrication is required."]}]]}],["$","li","3",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Install a sink and tap: as a rough guide, typically £150–£350 where existing plumbing is suitable. The figure may include cutting the worktop, fitting the sink and tap, connecting waste pipes and testing for leaks. A new sink position or difficult pipework may require additional plumbing."]}]]}],["$","li","4",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Connect or relocate plumbing: as a rough guide, typically £200–£700. Straightforward connections near existing services can cost less than moving a sink, dishwasher or washing machine across the room. New pipe runs, concealed work and access through floors or walls can increase the quote."]}]]}],["$","li","5",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Install an appliance: as a rough guide, typically £80–£250 per appliance. This may cover fitting and connecting items such as an oven, hob, extractor, dishwasher or washing machine, provided the relevant services are ready. Specialist extraction and changes to electrical supplies may need to be priced separately."]}]]}],["$","li","6",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Kitchen electrics: as a rough guide, typically £300–£1,500 for common additions or alterations. This may cover additional sockets, appliance connections, lighting, switches and selected changes to existing circuits. The cost depends on how much wiring is needed, whether walls or ceilings must be opened, and the number and type of appliances."]}]]}],["$","li","7",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Wall tiling: as a rough guide, typically £300–£1,200 for a standard kitchen splashback or selected wall areas. This can include surface preparation, adhesive, laying tiles, grouting and basic trims. Large-format, patterned, natural stone or uneven-wall installations can take longer."]}]]}],["$","li","8",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Kitchen flooring: as a rough guide, typically £400–£1,500 for fitting, depending on area and material. Laminate and vinyl can be simpler to install, while engineered timber, porcelain tiles or floors requiring extensive preparation may cost more. Subfloor repairs, levelling and removal of existing flooring are not always included."]}]]}],["$","li","9",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Painting and decorating: as a rough guide, typically £250–£800. This may include preparing and painting walls, ceilings, doors or woodwork after the main installation. Extra preparation, repairs, multiple colours and damaged surfaces can raise the cost."]}]]}],["$","li","10",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Final adjustment and snagging: as a rough guide, typically £150–£400. This can include aligning doors, adjusting drawers, fitting handles, sealing joints and checking completed connections. It is useful to confirm whether this is included in a full fitting quote rather than charged separately."]}]]}]]}],["$","aside",null,{"className":"my-10 rounded-2xl bg-gradient-to-br from-gray-900 via-gray-800 to-gray-900 p-6 sm:p-8 border border-[#C8A97E]/30","children":[["$","h3",null,{"className":"font-display text-xl sm:text-2xl font-bold text-white tracking-tight mb-2","children":"Thinking about your own project?"}],["$","p",null,{"className":"text-white/70 text-sm sm:text-base leading-relaxed mb-5","children":["BMB Renovation covers Watford, Bushey, Rickmansworth, St Albans, Hemel Hempstead and beyond — all trades in-house. Call +44 7775 758 717 or send us a message."]}],["$","$L4",null,{"href":"/contact","className":"inline-flex items-center gap-2 px-6 py-3 rounded-full bg-[#C8A97E] text-white text-sm font-bold hover:bg-[#b39668] transition-colors","children":["Get a Free Quote",["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right w-4 h-4","children":[["$","path","1ays0h",{"d":"M5 12h14"}],["$","path","xquz4c",{"d":"m12 5 7 7-7 7"}],"$undefined"]}]]}]]}],["$","h2",null,{"className":"font-display text-2xl sm:text-3xl font-bold text-gray-900 tracking-tight mt-12 mb-4","children":"What does a full kitchen installation cost?"}],["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["As a rough guide, fitting labour for a small or medium kitchen may typically fall around £3,000–£8,000 where the project includes cabinet installation, worktops, plumbing, appliance connections and some finishing work. A more extensive kitchen renovation, including new electrics, relocated plumbing, flooring, tiling and decoration, may cost more. These are guide ranges rather than fixed prices: every project differs, and the kitchen design, material choices and condition of the property can make a substantial difference. Request a free quote for accurate pricing."]}],["$","h3",null,{"className":"font-display text-xl sm:text-2xl font-bold text-gray-900 tracking-tight mt-8 mb-3","children":"What can increase the final kitchen fitting quote?"}],["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["The most reliable way to compare quotes is to check the scope line by line. Two companies may use similar wording but include different levels of preparation and finishing. Ask whether each price includes protection of existing areas, removal of waste, unit assembly, worktop cuts, appliance connections, silicone sealing, handles, plinths and final adjustments."]}],["$","ul",null,{"className":"my-5 space-y-2.5","children":[["$","li","0",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Layout changes: moving the sink, dishwasher, cooker or radiator can require new plumbing, electrics, ventilation or flooring repairs."]}]]}],["$","li","1",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Uneven walls and floors: units may need additional scribing, packing, levelling or remedial work before they can be fitted neatly."]}]]}],["$","li","2",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Older or damaged services: inaccessible or poorly positioned plumbing and wiring may need alterations before the new kitchen can be connected."]}]]}],["$","li","3",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Premium materials: stone worktops, natural timber, handmade tiles, large-format tiles and specialist finishes can require more careful preparation and installation."]}]]}],["$","li","4",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Appliance complexity: integrated appliances, downdraft extractors, induction hobs and built-in coffee machines may need precise cabinet modifications and suitable supplies."]}]]}],["$","li","5",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Access and disposal: upper-floor rooms, restricted parking, narrow entrances, long carrying distances and additional waste can add labour or disposal costs."]}]]}],["$","li","6",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Unexpected repairs: damp, damaged plaster, rotten flooring or hidden leaks may only become apparent after the old kitchen is removed."]}]]}]]}],["$","h2",null,{"className":"font-display text-2xl sm:text-3xl font-bold text-gray-900 tracking-tight mt-12 mb-4","children":"How to compare kitchen fitting quotes"}],["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["Start with a written specification showing the number of cabinets, worktop material, appliances and finishing areas. Check whether the price is labour only or includes materials, and whether VAT is included. It is also sensible to ask who will handle the different trades. BMB Renovation provides kitchen fitting and renovation in Watford, Bushey, Rickmansworth, St Albans, Hemel Hempstead, Borehamwood, Harrow, Croxley Green, Luton and Bedford. All plumbing, tiling, electrical and cabinet installation work is handled in-house. You can see the local ",["$","$L4","0",{"href":"/kitchen-fitting-watford","className":"text-[#C8A97E] font-medium underline decoration-[#C8A97E]/40 underline-offset-2 hover:decoration-[#C8A97E] transition-colors","children":"kitchen fitting service in Watford"}]," or read about ",["$","$L4","1",{"href":"/kitchen-renovation-watford","className":"text-[#C8A97E] font-medium underline decoration-[#C8A97E]/40 underline-offset-2 hover:decoration-[#C8A97E] transition-colors","children":"kitchen renovation in Watford"}]," before requesting a written scope."]}],["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["Before work starts, confirm the expected sequence: removal, first-fix plumbing and electrics, wall and floor preparation, cabinet installation, worktops, appliances, tiling, decorating and final snagging. Allowance items should be clearly marked, especially for worktops, tiles and unexpected repairs. If you are planning a project locally, BMB Renovation is based at 157 Judge Street, Watford WD24 5AN and offers free, no-obligation quotes. You can ",["$","$L4","0",{"href":"/contact","className":"text-[#C8A97E] font-medium underline decoration-[#C8A97E]/40 underline-offset-2 hover:decoration-[#C8A97E] transition-colors","children":"request a free quote"}]," with your room dimensions, preferred layout and a list of the work you need."]}],["$","aside",null,{"className":"my-10 rounded-2xl bg-gradient-to-br from-gray-900 via-gray-800 to-gray-900 p-6 sm:p-8 border border-[#C8A97E]/30","children":[["$","h3",null,{"className":"font-display text-xl sm:text-2xl font-bold text-white tracking-tight mb-2","children":"Get a Free, No-Obligation Quote"}],["$","p",null,{"className":"text-white/70 text-sm sm:text-base leading-relaxed mb-5","children":["BMB Renovation handles kitchens, bathrooms and full home renovations across Watford, Hertfordshire, North London & Bedfordshire — all trades in-house. Tell us about your project today."]}],["$","$L4",null,{"href":"/contact","className":"inline-flex items-center gap-2 px-6 py-3 rounded-full bg-[#C8A97E] text-white text-sm font-bold hover:bg-[#b39668] transition-colors","children":["Get My Free Quote",["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"