h","4m81vk",{"d":"M16 2v4"}],["$","rect","1hopcy",{"width":"18","height":"18","x":"3","y":"4","rx":"2"}],["$","path","8toen8",{"d":"M3 10h18"}],"$undefined"]}],"30 July 2026",["$","span",null,{"className":"text-white/25","children":"·"}],["$","span",null,{"children":"BMB Renovation"}]]}]]}]}],["$","article",null,{"className":"py-14 sm:py-20 flex-grow bg-gray-50","children":["$","div",null,{"className":"max-w-[800px] mx-auto px-4 sm:px-6","children":["$","div",null,{"className":"bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10","children":[["$","div",null,{"children":[["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["Choosing kitchen fitters in Rickmansworth involves more than finding someone to install a run of cabinets. A kitchen project may include removing the old units, preparing walls and floors, altering plumbing, installing appliances, fitting worktops, tiling and completing electrical work. The right contractor should understand how these elements affect one another and give you a quote that reflects the whole job. This guide explains what to compare, which questions to ask and how to prepare for an accurate quotation."]}],["$","h2",null,{"className":"font-display text-2xl sm:text-3xl font-bold text-gray-900 tracking-tight mt-12 mb-4","children":"What should a kitchen fitter’s service include?"}],["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["Kitchen fitting can mean different things depending on the contractor. Some fitters install cabinets only, while others provide a more complete renovation service. Before comparing prices, ask each company to explain exactly what is included. A full service may cover removal and disposal of the old kitchen, cabinet installation, worktops, sink and tap fitting, appliance connections, flooring, tiling, decorating and making good around the new units. It is also worth checking whether materials are supplied by the fitter or purchased directly by you."]}],["$","ul",null,{"className":"my-5 space-y-2.5","children":[["$","li","0",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Cabinet and drawer installation, including adjustments for uneven walls or floors."]}]]}],["$","li","1",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Worktop cutting and fitting, particularly where joints, sinks or hobs are involved."]}]]}],["$","li","2",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Plumbing for sinks, dishwashers, washing machines and other appliances."]}]]}],["$","li","3",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Electrical work, lighting and appliance connections where required."]}]]}],["$","li","4",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Wall preparation, splashbacks, tiling, flooring and final decorating."]}]]}],["$","li","5",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Removal of existing units and clearance of waste, if this is part of the agreement."]}]]}]]}],["$","aside",null,{"className":"my-10 rounded-2xl bg-gradient-to-br from-gray-900 via-gray-800 to-gray-900 p-6 sm:p-8 border border-[#C8A97E]/30","children":[["$","h3",null,{"className":"font-display text-xl sm:text-2xl font-bold text-white tracking-tight mb-2","children":"Thinking about your own project?"}],["$","p",null,{"className":"text-white/70 text-sm sm:text-base leading-relaxed mb-5","children":["BMB Renovation covers Watford, Bushey, Rickmansworth, St Albans, Hemel Hempstead and beyond — all trades in-house. Call +44 7775 758 717 or send us a message."]}],["$","$L4",null,{"href":"/contact","className":"inline-flex items-center gap-2 px-6 py-3 rounded-full bg-[#C8A97E] text-white text-sm font-bold hover:bg-[#b39668] transition-colors","children":["Get a Free Quote",["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right w-4 h-4","children":[["$","path","1ays0h",{"d":"M5 12h14"}],["$","path","xquz4c",{"d":"m12 5 7 7-7 7"}],"$undefined"]}]]}]]}],["$","h2",null,{"className":"font-display text-2xl sm:text-3xl font-bold text-gray-900 tracking-tight mt-12 mb-4","children":"Compare kitchen fitters on more than price"}],["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["The lowest quotation is not automatically the best value. A low figure may exclude preparation work, waste removal, appliance connections or finishing details that you assumed were included. Conversely, a higher quote may reflect more extensive work, materials or a clearer scope. Compare like for like by asking for an itemised breakdown of labour, materials, any subcontracted work, disposal and likely extras. Ask whether the quote is fixed, provisional or subject to a site survey."]}],["$","h3",null,{"className":"font-display text-xl sm:text-2xl font-bold text-gray-900 tracking-tight mt-8 mb-3","children":"Questions to ask before appointing a fitter"}],["$","ul",null,{"className":"my-5 space-y-2.5","children":[["$","li","0",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Have you completed projects similar in size and layout to mine?"]}]]}],["$","li","1",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Who will carry out the plumbing, electrical, tiling and cabinet installation?"]}]]}],["$","li","2",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Will one team coordinate the different stages, or will I need to arrange separate trades?"]}]]}],["$","li","3",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["What happens if the walls, floor or existing services are not as expected?"]}]]}],["$","li","4",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["How will changes to the agreed work be priced and approved?"]}]]}],["$","li","5",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["What preparation do I need to complete before the installation begins?"]}]]}],["$","li","6",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["How will the kitchen be protected from dust and damage during the work?"]}]]}]]}],["$","h2",null,{"className":"font-display text-2xl sm:text-3xl font-bold text-gray-900 tracking-tight mt-12 mb-4","children":"Plan the practical details of your Rickmansworth kitchen project"}],["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["The design and layout will influence both the work involved and the timescale. Keeping the sink, dishwasher and cooking area near existing services may reduce alterations, although the best layout depends on the room and how you use it. Moving plumbing, adding sockets, changing lighting or removing walls can turn a straightforward replacement into a wider renovation. Older properties may also need more preparation if walls are out of square, floors are uneven or previous installations have left hidden damage."]}],["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["Think about access and daily life as well. Confirm where materials will be delivered, how old units will leave the property and whether there is somewhere to store appliances or boxes. You may need to arrange temporary cooking and washing facilities. If structural changes, significant electrical alterations or other regulated work are proposed, ask your contractor what approvals or inspections may be relevant and whether you need independent professional advice."]}],["$","h2",null,{"className":"font-display text-2xl sm:text-3xl font-bold text-gray-900 tracking-tight mt-12 mb-4","children":"How to request an accurate kitchen fitting quote"}],["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["A site visit can be more useful than a quotation based only on photographs or measurements. Give the fitter as much information as possible: the room dimensions, your preferred layout, appliance list, worktop choice, flooring and splashback requirements, and whether the existing kitchen is being removed. Mention any changes you are considering, such as moving a doorway, opening the room to another area or replacing a window. These details can help the contractor identify preparation work before the project starts."]}],["$","ul",null,{"className":"my-5 space-y-2.5","children":[["$","li","0",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Provide a simple plan or measurements showing doors, windows, radiators and existing service points."]}]]}],["$","li","1",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["List the appliances you already own or intend to buy, including their dimensions."]}]]}],["$","li","2",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Separate items you are supplying from items the contractor is expected to source."]}]]}],["$","li","3",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Ask for labour, materials, disposal and optional work to be shown separately."]}]]}],["$","li","4",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Check the estimated programme, payment stages and how variations will be agreed."]}]]}],["$","li","5",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Confirm what cleaning, making good and final snagging are included."]}]]}]]}],["$","h2",null,{"className":"font-display text-2xl sm:text-3xl font-bold text-gray-900 tracking-tight mt-12 mb-4","children":"A local option for kitchen fitting in Rickmansworth"}],["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["BMB Renovation is based at 157 Judge Street, Watford WD24 5AN, and serves Rickmansworth as well as other areas across Hertfordshire, North London and Bedfordshire. Its kitchen fitting and renovation service includes plumbing, tiling, electrical and cabinet installation work handled in-house. This means you can discuss the full scope of a project with one renovation company. You can review the ",["$","$L4","0",{"href":"/kitchen-fitting-rickmansworth","className":"text-[#C8A97E] font-medium underline decoration-[#C8A97E]/40 underline-offset-2 hover:decoration-[#C8A97E] transition-colors","children":"kitchen fitting service for Rickmansworth"}]," and compare it with the company’s wider ",["$","$L4","1",{"href":"/services","className":"text-[#C8A97E] font-medium underline decoration-[#C8A97E]/40 underline-offset-2 hover:decoration-[#C8A97E] transition-colors","children":"renovation services"}],"."]}],["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["For a useful first conversation, prepare your room measurements, photographs, appliance details and a short description of the result you want. BMB Renovation offers free, no-obligation quotes, so you can ask for the proposed work and costs to be explained before deciding. You can request this through the ",["$","$L4","0",{"href":"/contact","className":"text-[#C8A97E] font-medium underline decoration-[#C8A97E]/40 underline-offset-2 hover:decoration-[#C8A97E] transition-colors","children":"contact page"}],", or contact the team on +44 7775 758 717 or contact@bmbrenovation.co.uk."]}],["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["Take time to read the quotation and clarify anything that is ambiguous before work starts. A kitchen fitter should be able to explain what is included, identify assumptions and discuss possible issues before work begins. With a clear scope, realistic preparation and an agreed process for changes, you can make more informed decisions about your kitchen project."]}],["$","aside",null,{"className":"my-10 rounded-2xl bg-gradient-to-br from-gray-900 via-gray-800 to-gray-900 p-6 sm:p-8 border border-[#C8A97E]/30","children":[["$","h3",null,{"className":"font-display text-xl sm:text-2xl font-bold text-white tracking-tight mb-2","children":"Get a Free, No-Obligation Quote"}],["$","p",null,{"className":"text-white/70 text-sm sm:text-base leading-relaxed mb-5","children":["BMB Renovation handles kitchens, bathrooms and full home renovations across Watford, Hertfordshire, North London & Bedfordshire — all trades in-house. Tell us about your project today."]}],["$","$L4",null,{"href":"/contact","className":"inline-flex items-center gap-2 px-6 py-3 rounded-full bg-[#C8A97E] text-white text-sm font-bold hover:bg-[#b39668] transition-colors","children":["Get My Free Quote",["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right w-4 h-4","children":[["$","path","1ays0h",{"d":"M5 12h14"}],["$","path","xquz4c",{"d":"m12 5 7 7-7 7"}],"$undefined"]}]]}]]}]]}],["$","section",null,{"className":"mt-14","children":[["$","div",null,{"className":"flex items-center gap-2.5 mb-6","children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle-help w-6 h-6 text-[#C8A97E]","children":[["$","circle","1mglay",{"cx":"12","cy":"12","r":"10"}],["$","path","1u773s",{"d":"M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"}],["$","path","p32p05",{"d":"M12 17h.01"}],"$undefined"]}],["$","h2",null,{"className":"font-display text-2xl sm:text-3xl font-bold text-gr