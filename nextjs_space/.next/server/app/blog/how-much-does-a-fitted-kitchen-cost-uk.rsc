","1cmpym",{"d":"M8 2v4"}],["$","path","4m81vk",{"d":"M16 2v4"}],["$","rect","1hopcy",{"width":"18","height":"18","x":"3","y":"4","rx":"2"}],["$","path","8toen8",{"d":"M3 10h18"}],"$undefined"]}],"1 August 2026",["$","span",null,{"className":"text-white/25","children":"·"}],["$","span",null,{"children":"BMB Renovation"}]]}]]}]}],["$","article",null,{"className":"py-14 sm:py-20 flex-grow bg-gray-50","children":["$","div",null,{"className":"max-w-[800px] mx-auto px-4 sm:px-6","children":["$","div",null,{"className":"bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10","children":[["$","div",null,{"children":[["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["If you are searching for how much a fitted kitchen costs in the UK, the honest answer is that the total depends on far more than the price of the cabinets. As a rough UK guide, a small, straightforward replacement kitchen may typically cost around £8,000 to £12,000, while a larger kitchen with higher-specification units, new appliances and structural or service changes may reach £20,000 to £35,000 or more. Every project differs: room size, specification, access, location and the amount of building work will affect the final price. Get a free, no-obligation quote for accurate pricing."]}],["$","h2",null,{"className":"font-display text-2xl sm:text-3xl font-bold text-gray-900 tracking-tight mt-12 mb-4","children":"Typical total cost of a fitted kitchen in the UK"}],["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["For a standard kitchen replacement, it helps to think about the project in five main parts: units, worktops, appliances, installation and extras. As a rough UK guide, a budget kitchen with basic laminate worktops and a modest appliance package may typically fall in the £8,000–£12,000 range. A mid-range fitted kitchen may be around £12,000–£20,000, while a larger or more bespoke project can exceed £25,000. Labour and building work can make a substantial difference, particularly if the layout is changing. Every project differs, so obtain a free, no-obligation quote for accurate pricing."]}],["$","ul",null,{"className":"my-5 space-y-2.5","children":[["$","li","0",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Budget kitchen: as a rough UK guide, typically £8,000–£12,000, often with standard units, laminate worktops and carefully selected appliances."]}]]}],["$","li","1",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Mid-range kitchen: as a rough UK guide, typically £12,000–£20,000, with more choice of finishes, improved worktops and a broader appliance specification."]}]]}],["$","li","2",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Higher-specification kitchen: as a rough UK guide, typically £20,000–£35,000 or more, particularly where there are bespoke units, premium materials, layout changes or substantial renovation work."]}]]}]]}],["$","aside",null,{"className":"my-10 rounded-2xl bg-gradient-to-br from-gray-900 via-gray-800 to-gray-900 p-6 sm:p-8 border border-[#C8A97E]/30","children":[["$","h3",null,{"className":"font-display text-xl sm:text-2xl font-bold text-white tracking-tight mb-2","children":"Thinking about your own project?"}],["$","p",null,{"className":"text-white/70 text-sm sm:text-base leading-relaxed mb-5","children":["BMB Renovation covers Watford, Bushey, Rickmansworth, St Albans, Hemel Hempstead and beyond — all trades in-house. Call +44 7775 758 717 or send us a message."]}],["$","$L4",null,{"href":"/contact","className":"inline-flex items-center gap-2 px-6 py-3 rounded-full bg-[#C8A97E] text-white text-sm font-bold hover:bg-[#b39668] transition-colors","children":["Get a Free Quote",["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right w-4 h-4","children":[["$","path","1ays0h",{"d":"M5 12h14"}],["$","path","xquz4c",{"d":"m12 5 7 7-7 7"}],"$undefined"]}]]}]]}],["$","h2",null,{"className":"font-display text-2xl sm:text-3xl font-bold text-gray-900 tracking-tight mt-12 mb-4","children":"What do the units and worktops cost?"}],["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["The cost of kitchen units varies with the number of cabinets, construction, finish and storage options. As a rough UK guide, standard flat-pack or entry-level units for a small or average-sized kitchen may typically cost around £2,000–£5,000. Mid-range rigid or made-to-measure options may be closer to £5,000–£10,000, while painted, solid timber or highly bespoke cabinetry can cost more. Drawers, tall larders, pull-out storage, integrated bins and internal organisers can increase the price. Every project differs, so get a free, no-obligation quote for accurate pricing."]}],["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["As a rough UK guide, basic laminate worktops in a typical kitchen may typically cost around £500–£1,500. Solid timber, compact laminate, granite, quartz and other stone surfaces may take the worktop budget to £2,000–£5,000 or more, depending on the material, thickness, joins, cut-outs and installation. An undermount sink or detailed edge profile may also add fabrication costs. Choosing a durable laminate or compact laminate can reduce the initial spend without changing the layout. Every project differs, so obtain a free, no-obligation quote for accurate pricing."]}],["$","h2",null,{"className":"font-display text-2xl sm:text-3xl font-bold text-gray-900 tracking-tight mt-12 mb-4","children":"Appliances and kitchen fitting costs"}],["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["Appliance costs vary by brand, model, energy features and whether appliances are integrated. As a rough UK guide, a basic package of an oven, hob, extractor, dishwasher, fridge-freezer and washing machine may typically cost around £2,000–£4,000. Mid-range appliances may take this to £4,000–£7,000, while premium or fully integrated models can cost considerably more. Check whether delivery, removal of old appliances, connection and installation are included, as these may not be covered by a retailer’s headline price. Every project differs, so get a free, no-obligation quote for accurate pricing."]}],["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["As a rough UK guide, installation for a straightforward kitchen may typically cost around £2,000–£5,000, but there is no single standard fitting price. The figure depends on the number of units, worktop material, flooring, tiling, plumbing, electrical work and how ready the room is. Moving a sink, cooker or dishwasher can mean altering water, waste or electrical services. Every project differs, so get a free, no-obligation quote for accurate pricing. For work in Hertfordshire, North London or Bedfordshire, BMB Renovation offers kitchen fitting and renovation. All plumbing, tiling, electrical and cabinet installation work is handled in-house. You can see the ",["$","$L4","0",{"href":"/kitchen-fitting-watford","className":"text-[#C8A97E] font-medium underline decoration-[#C8A97E]/40 underline-offset-2 hover:decoration-[#C8A97E] transition-colors","children":"kitchen fitting service in Watford"}]," or request a ",["$","$L4","1",{"href":"/contact","className":"text-[#C8A97E] font-medium underline decoration-[#C8A97E]/40 underline-offset-2 hover:decoration-[#C8A97E] transition-colors","children":"free, no-obligation quote"}],"."]}],["$","h2",null,{"className":"font-display text-2xl sm:text-3xl font-bold text-gray-900 tracking-tight mt-12 mb-4","children":"Common extras that affect the final price"}],["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["The difference between an online kitchen price and the final fitted cost can often be the list of extras. Before comparing quotes, ask each contractor to identify these separately so you can see what is included."]}],["$","ul",null,{"className":"my-5 space-y-2.5","children":[["$","li","0",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Removal and disposal of the old kitchen: as a rough UK guide, typically around £300–£800, depending on the amount of cabinetry and waste."]}]]}],["$","li","1",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Plumbing and electrical alterations: minor changes may cost several hundred pounds, while relocating or upgrading services can cost more."]}]]}],["$","li","2",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Wall preparation, plastering and decorating: as a rough UK guide, typically around £500–£2,000, depending on the condition of the room."]}]]}],["$","li","3",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Tiling or splashbacks: as a rough UK guide, typically around £500–£2,500, depending on the area, tile choice and preparation required."]}]]}],["$","li","4",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Flooring: as a rough UK guide, typically around £800–£3,000 for many kitchens, with material, subfloor condition and room size affecting the figure."]}]]}],["$","li","5",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Structural changes, such as removing a wall or creating a wider opening, can add several thousand pounds and should be assessed separately."]}]]}],["$","li","6",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Design fees, delivery, appliance installation, lighting, handles, taps, sinks and waste removal may be included or charged as separate line items."]}]]}],["$","li","7",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Every project differs, so use these figures only as a guide and get a free, no-obligation quote for accurate pricing."]}]]}]]}],["$","h2",null,{"className":"font-display text-2xl sm:text-3xl font-bold text-gray-900 tracking-tight mt-12 mb-4","children":"How to reduce the cost without compromising the result"}],["$","ul",null,{"className":"my-5 space-y-2.5","children":[["$","li","0",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Keep the existing layout where possible. Retaining the sink, cooker and dishwasher positions can reduce plumbing, electrical and flooring work."]}]]}],["$","li","1",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Spend selectively on visible or heavily used elements. A better worktop and reliable oven may offer more practical value than premium internal accessories in every cabinet."]}]]}],["$","li","2",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Compare the complete specification, not just the cabinet price. A low headline figure may exclude fitting, handles, panels, end finishes, delivery or appliance connections."]}]]}],["$","li","3",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Use standard cabinet sizes and limit bespoke units to awkward corners or specific storage needs."]}]]}],["$","li","4",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Choose a hard-wearing mid-range worktop and a simple splashback if the budget is tight; these can be upgraded later more easily than hidden services."]}]]}],["$","li","5",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Ask whether your existing appliances can be reused, but check their dimensions, condition and warranty before designing around them."]}]]}],["$","li","6",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Set aside a contingency within your budget for unforeseen work. Older properties can reveal uneven walls, damaged flooring or outdated services once the room is opened up."]}]]}]]}],["$","h2",null,{"className":"font-display text-2xl sm:text-3xl font-bold text-gray-900 tracking-tight mt-12 mb-4","children":"What should a fitted kitchen quote include?"}],["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["A useful quote should describe the units, doors, handles, panels, plinths, worktops, sink, taps and appliances by model or specification. It should also state the labour included, preparation work, removal of the old kitchen, waste disposal, delivery, connections, tiling, flooring and decorating. Ask whether prices include VAT, and confirm how changes or unforeseen work will be agreed. Getting two or three like-for-like quotations can make comparisons more meaningful than choosing the lowest total alone. BMB Renovation is based in Watford and provides kitchen fitting and renovation in Watford, Bushey, Rickmansworth, St Albans, Hemel Hempstead, Borehamwood, Harrow, Croxley Green, Luton and Bedford. Details of the wider ",["$","$L4","0",{"href":"/kitchen-renovation-watford","className":"text-[#C8A97E] font-medium underline decoration-[#C8A97E]/40 underline-offset-2 hover:decoration-[#C8A97E] transition-colors","children":"kitchen renovation service"}]," can help you decide what needs to be included."]}],["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["In practical terms, as a rough UK guide, a complete mid-range fitted kitchen may typically cost around £12,000–£20,000 before unusual structural work. Treat this as a starting point rather than a promise: every project differs and the final cost will depend on the room and the choices you make. Get a free, no-obligation quote for accurate pricing. A clear design, itemised quote and early decision about the layout can help keep the project under control."]}],["$","aside",null,{"className":"my-10 rounded-2xl bg-gradient-to-br from-gray-900 via-gray-800 to-gray-900 p-6 sm:p-8 border border-[#C8A97E]/30","children":[["$","h3",null,{"className":"font-display text-xl sm:text-2xl font-bold text-white tracking-tight mb-2","children":"Get a Free, No-Obligation Quote"}],["$","p",null,{"className":"text-white/70 text-sm sm:text-base leading-relaxed mb-5","children":["BMB Renovation handles kitchens, bathrooms and full home renovations across Watford, Hertfordshire, North London & Bedfordshire — all trades in-house. Tell us about your project today."]}],["$","$L4",null,{"href":"/contact","className":"inline-flex items-center gap-2 px-6 py-3 rounded-full bg-[#C8A97E] text-white text-sm font-bold hover:bg-[#b39668] transition-colors","children":["Get My Free Quote",["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right w-4 h-4","children":[["$","path","1ays0h",{"d":"M5 12h14"}],["$","path","xquz4c",{"d":"m12 5 7 7-7 7"}],"$undefined"]}]]}]]}]]}],["$","section",null,{"className":"mt-14","children":[["$","div",null,{"className":"flex items-center gap-2.5 mb-6","children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle-help w-6 h-6 text-[#C8A97E]","children":[["$","circle","1mglay",{"cx":"12","cy":"12","r":"10"}],["$","path","1u773s",{"d":"M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"}],["$","path","p32p05",{"d":"M12 17h.01"}],"$undefined"]}],["$","h2",null,{"className":"font-display text-2xl sm:text-3xl font-bold text-gray-900 tracking-tight","children":"Frequently Asked Questions"}]]}],["$","div",null,{"className":"space-y-3","children":[["$","details","0",{"className":"group bg-white rounded-xl border border-gray-100