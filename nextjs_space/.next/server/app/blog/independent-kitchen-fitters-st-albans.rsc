e lucide-calendar w-4 h-4","children":[["$","path","1cmpym",{"d":"M8 2v4"}],["$","path","4m81vk",{"d":"M16 2v4"}],["$","rect","1hopcy",{"width":"18","height":"18","x":"3","y":"4","rx":"2"}],["$","path","8toen8",{"d":"M3 10h18"}],"$undefined"]}],"1 August 2026",["$","span",null,{"className":"text-white/25","children":"·"}],["$","span",null,{"children":"BMB Renovation"}]]}]]}]}],["$","article",null,{"className":"py-14 sm:py-20 flex-grow bg-gray-50","children":["$","div",null,{"className":"max-w-[800px] mx-auto px-4 sm:px-6","children":["$","div",null,{"className":"bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10","children":[["$","div",null,{"children":[["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["Choosing an independent kitchen fitter in St Albans may offer a more direct point of contact than using a large showroom or national installation company. However, the quality and scope of service can vary, and the cheapest quote is not always the best value. Before booking, it is worth checking exactly what the fitter does, who carries out plumbing and electrical work, what is included in the price and how changes or problems will be handled. This guide explains what to look for when planning a kitchen installation or renovation in St Albans."]}],["$","h2",null,{"className":"font-display text-2xl sm:text-3xl font-bold text-gray-900 tracking-tight mt-12 mb-4","children":"What should an independent kitchen fitter offer?"}],["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["A kitchen fitting project is rarely limited to fixing cupboards in place. Depending on the condition of the room and your plans, the work may include removing the existing kitchen, preparing walls and floors, fitting cabinets, installing worktops, connecting appliances, moving plumbing, changing lighting, tiling, decorating and completing final adjustments. A fitter should explain which parts they can manage directly and which require other trades."]}],["$","ul",null,{"className":"my-5 space-y-2.5","children":[["$","li","0",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Removal and disposal of the old kitchen, if required"]}]]}],["$","li","1",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Cabinet, drawer, worktop and splashback installation"]}]]}],["$","li","2",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Plumbing for sinks, dishwashers, washing machines and other appliances"]}]]}],["$","li","3",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Electrical work for sockets, lighting and fixed appliances, where appropriate"]}]]}],["$","li","4",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Wall preparation, plastering, tiling, flooring and decorating"]}]]}],["$","li","5",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Minor carpentry and adjustments needed to make the new kitchen fit properly"]}]]}],["$","li","6",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Final checks, sealing, door alignment and making good around the installation"]}]]}]]}],["$","aside",null,{"className":"my-10 rounded-2xl bg-gradient-to-br from-gray-900 via-gray-800 to-gray-900 p-6 sm:p-8 border border-[#C8A97E]/30","children":[["$","h3",null,{"className":"font-display text-xl sm:text-2xl font-bold text-white tracking-tight mb-2","children":"Thinking about your own project?"}],["$","p",null,{"className":"text-white/70 text-sm sm:text-base leading-relaxed mb-5","children":["BMB Renovation covers Watford, Bushey, Rickmansworth, St Albans, Hemel Hempstead and beyond — all trades in-house. Call +44 7775 758 717 or send us a message."]}],["$","$L4",null,{"href":"/contact","className":"inline-flex items-center gap-2 px-6 py-3 rounded-full bg-[#C8A97E] text-white text-sm font-bold hover:bg-[#b39668] transition-colors","children":["Get a Free Quote",["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right w-4 h-4","children":[["$","path","1ays0h",{"d":"M5 12h14"}],["$","path","xquz4c",{"d":"m12 5 7 7-7 7"}],"$undefined"]}]]}]]}],["$","h2",null,{"className":"font-display text-2xl sm:text-3xl font-bold text-gray-900 tracking-tight mt-12 mb-4","children":"Check the scope before comparing quotes"}],["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["Kitchen quotes can look very different because fitters do not always include the same tasks. Ask for a written, itemised quotation rather than relying on a single total. It should state whether the price covers removal, waste, delivery coordination, cabinet assembly, worktop cutting, appliance connections, plumbing alterations, electrical work, tiling, flooring, decorating and making good. It should also identify anything excluded, such as the cost of kitchen units, appliances, specialist worktops or building work."]}],["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["Existing properties can reveal uneven walls, hidden pipework or damaged flooring once the old kitchen is removed. Not every issue can be identified during an initial visit, but the fitter should explain potential unknowns and confirm how additional work will be agreed before it starts. This can give you a clearer budget and reduce the risk of unexpected charges."]}],["$","h2",null,{"className":"font-display text-2xl sm:text-3xl font-bold text-gray-900 tracking-tight mt-12 mb-4","children":"How much does kitchen fitting cost in St Albans?"}],["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["As a rough guide, fitting labour for a straightforward kitchen may cost several thousand pounds, while a more involved renovation involving plumbing changes, electrical work, plastering, flooring and tiling may typically cost around £5,000 to £15,000 or more for labour and associated works. Units, worktops and appliances may be separate, and premium materials or structural alterations can increase the total. These are broad guide figures only: every project differs, so request a free, no-obligation quote for accurate pricing."]}],["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["The main cost drivers are the size and layout of the kitchen, whether existing services can stay in place, the number of cabinets, the type of worktop, the condition of walls and floors, appliance installation, and the amount of finishing work required. Keeping the sink and appliances in their current positions can sometimes reduce labour, while changing the layout can add plumbing, electrical and preparation costs. Ask whether VAT is included and whether the quote covers materials as well as labour."]}],["$","h2",null,{"className":"font-display text-2xl sm:text-3xl font-bold text-gray-900 tracking-tight mt-12 mb-4","children":"Questions to ask independent kitchen fitters in St Albans"}],["$","ul",null,{"className":"my-5 space-y-2.5","children":[["$","li","0",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["How many stages are included, and who will coordinate the different trades?"]}]]}],["$","li","1",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Do you handle cabinet installation, plumbing, tiling and electrical work in-house or use subcontractors?"]}]]}],["$","li","2",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Have you fitted the type of kitchen, worktop and appliances I am considering?"]}]]}],["$","li","3",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Will you visit the property to check measurements, walls, floors, access and existing services?"]}]]}],["$","li","4",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["What exactly is included in the written quote, and what is excluded?"]}]]}],["$","li","5",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["How are variations or unforeseen repairs approved and charged?"]}]]}],["$","li","6",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Who is responsible for ordering, checking and storing the cabinets and appliances?"]}]]}],["$","li","7",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["How long is the estimated programme, and what could cause it to change?"]}]]}],["$","li","8",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["How will the room be protected during the work, and who removes waste?"]}]]}],["$","li","9",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["What happens if a door, panel, worktop or appliance arrives damaged or does not fit?"]}]]}]]}],["$","h2",null,{"className":"font-display text-2xl sm:text-3xl font-bold text-gray-900 tracking-tight mt-12 mb-4","children":"Signs of a dependable kitchen fitter"}],["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["A dependable fitter should communicate clearly before work begins, take accurate measurements and be willing to explain the practical consequences of your design choices. Look for a written scope, a realistic programme and a clear payment schedule. Be cautious if you are asked for a large payment before the work is properly specified, if the quote is unusually vague, or if the fitter cannot explain who will complete electrical or plumbing tasks."]}],["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["Independent does not have to mean limited in scope. BMB Renovation is based in Watford and serves St Albans. It offers kitchen fitting and renovation, with all plumbing, tiling, electrical and cabinet installation work handled in-house. BMB Renovation also offers flooring, carpentry, painting and decorating, house renovation, house extensions, loft conversions and general handyman work. You can review the ",["$","$L4","0",{"href":"/kitchen-fitting-st-albans","className":"text-[#C8A97E] font-medium underline decoration-[#C8A97E]/40 underline-offset-2 hover:decoration-[#C8A97E] transition-colors","children":"kitchen fitting service for St Albans"}]," or see the wider range of ",["$","$L4","1",{"href":"/services","className":"text-[#C8A97E] font-medium underline decoration-[#C8A97E]/40 underline-offset-2 hover:decoration-[#C8A97E] transition-colors","children":"renovation services"}]," before deciding what support you need."]}],["$","h2",null,{"className":"font-display text-2xl sm:text-3xl font-bold text-gray-900 tracking-tight mt-12 mb-4","children":"Prepare for a smoother kitchen installation"}],["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["Before requesting quotes, make a simple list of your priorities: storage, worktop space, seating, appliance locations, lighting, flooring and any accessibility needs. Collect measurements, photographs and details of the kitchen units or appliances you have selected, but do not rely on your own measurements alone. The fitter should verify them on site before cabinets or worktops are ordered."]}],["$","ul",null,{"className":"my-5 space-y-2.5","children":[["$","li","0",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Decide which existing appliances, units or fittings will be kept"]}]]}],["$","li","1",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Check delivery dates so cabinets are available when the installation is due to start"]}]]}],["$","li","2",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Allow time for design decisions, product lead times and possible remedial work"]}]]}],["$","li","3",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Ask how cooking, washing and refrigeration will be managed during the installation"]}]]}],["$","li","4",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Keep the written quote, drawings, product details and agreed changes together"]}]]}],["$","li","5",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Confirm the final payment terms and what completion checks will take place"]}]]}]]}],["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["The best independent kitchen fitter is not simply the person offering the lowest initial price. It is a contractor who understands the whole job, records what is included, communicates when circumstances change and completes the agreed work. Taking time to compare detailed quotes and ask direct questions can help you make a more informed choice for your St Albans home."]}],["$","aside",null,{"className":"my-10 rounded-2xl bg-gradient-to-br from-gray-900 via-gray-800 to-gray-900 p-6 sm:p-8 border border-[#C8A97E]/30","children":[["$","h3",null,{"className":"font-display text-xl sm:text-2xl font-bold text-white tracking-tight mb-2","children":"Get a Free, No-Obligation Quote"}],["$","p",null,{"className":"text-white/70 text-sm sm:text-base leading-relaxed mb-5","children":["BMB Ren