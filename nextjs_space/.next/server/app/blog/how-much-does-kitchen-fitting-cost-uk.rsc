xt-[#C8A97E] text-xl leading-none group-open:rotate-45 transition-transform flex-shrink-0","children":"+"}]]}],["$","div",null,{"className":"px-5 pb-5 text-gray-600 text-sm leading-relaxed border-t border-gray-50 pt-4","children":["Not always. Some installers may include basic connections, but moving water, waste, gas or electrical points can be priced separately. Ask for each trade and task to be listed clearly in the quotation."]}]]}],["$","details","3",{"className":"group bg-white rounded-xl border border-gray-100 shadow-sm open:border-[#C8A97E]/40","children":[["$","summary",null,{"className":"cursor-pointer list-none flex items-center justify-between gap-4 p-5 font-semibold text-gray-900 text-sm sm:text-base [&::-webkit-details-marker]:hidden","children":["How long does it take to fit a kitchen?",["$","span",null,{"className":"text-[#C8A97E] text-xl leading-none group-open:rotate-45 transition-transform flex-shrink-0","children":"+"}]]}],["$","div",null,{"className":"px-5 pb-5 text-gray-600 text-sm leading-relaxed border-t border-gray-50 pt-4","children":["The duration varies with the size of the kitchen, room preparation, deliveries and the number of trades involved. A straightforward installation may be completed more quickly than a full renovation involving structural work, new services, tiling or flooring."]}]]}],["$","details","4",{"className":"group bg-white rounded-xl border border-gray-100 shadow-sm open:border-[#C8A97E]/40","children":[["$","summary",null,{"className":"cursor-pointer list-none flex items-center justify-between gap-4 p-5 font-semibold text-gray-900 text-sm sm:text-base [&::-webkit-details-marker]:hidden","children":["How can I reduce the cost of a kitchen refit?",["$","span",null,{"className":"text-[#C8A97E] text-xl leading-none group-open:rotate-45 transition-transform flex-shrink-0","children":"+"}]]}],["$","div",null,{"className":"px-5 pb-5 text-gray-600 text-sm leading-relaxed border-t border-gray-50 pt-4","children":["Keeping the existing layout, comparing materials, retaining suitable appliances and avoiding unnecessary structural changes can reduce costs. Do not omit essential preparation, safe connections or ventilation to save money."]}]]}]]}]]}],["$","section",null,{"className":"mt-14 pt-8 border-t border-gray-100","children":[["$","div",null,{"className":"flex items-center gap-2.5 mb-5","children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-wrench w-5 h-5 text-[#C8A97E]","children":[["$","path","cbrjhi",{"d":"M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"}],"$undefined"]}],["$","h2",null,{"className":"font-display text-xl font-bold text-gray-900 tracking-tight","children":"Related Services"}]]}],["$","div",null,{"className":"flex flex-wrap gap-3","children":[["$","$L4","/kitchen-fitting-watford",{"href":"/kitchen-fitting-watford","className":"px-4 py-2.5 rounded-full bg-gray-50 border border-gray-200 text-sm font-medium text-gray-700 hover:border-[#C8A97E] hover:text-[#C8A97E] transition-colors","children":"Kitchen Fitting Watford"}],["$","$L4","/kitchen-renovation-watford",{"href":"/kitchen-renovation-watford","className":"px-4 py-2.5 rounded-full bg-gray-50 border border-gray-200 text-sm font-medium text-gray-700 hover:border-[#C8A97E] hover:text-[#C8A97E] transition-colors","children":"Kitchen Renovation Watford"}],["$","$L4","/contact",{"href":"/contact","className":"px-4 py-2.5 rounded-full bg-gray-50 border border-gray-200 text-sm font-medium text-gray-700 hover:border-[#C8A97E] hover:text-[#C8A97E] transition-colors","children":"Contact"}]]}]]}]]}]}]}],["$","$L5",null,{}]]}],null],null],null]},[null,["$","$L6",null,{"parallelRouterKey":"children","segmentPath":["children","blog","children","$