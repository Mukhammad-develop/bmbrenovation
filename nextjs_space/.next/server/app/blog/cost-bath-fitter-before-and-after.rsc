"d":"M16 2v4"}],["$","rect","1hopcy",{"width":"18","height":"18","x":"3","y":"4","rx":"2"}],["$","path","8toen8",{"d":"M3 10h18"}],"$undefined"]}],"7 August 2026",["$","span",null,{"className":"text-white/25","children":"·"}],["$","span",null,{"children":"BMB Renovation"}]]}]]}]}],["$","article",null,{"className":"py-14 sm:py-20 flex-grow bg-gray-50","children":["$","div",null,{"className":"max-w-[800px] mx-auto px-4 sm:px-6","children":["$","div",null,{"className":"bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10","children":[["$","div",null,{"children":[["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["Searching for “cost bath fitter before and after” usually means you want two things: a realistic idea of the price and a clear picture of what the finished bathroom could look like. A surface-led bathroom update can create a noticeable transformation without removing every wall or replacing every fixture, but the final cost depends on the condition of the existing bathroom and the level of work required."]}],["$","h2",null,{"className":"font-display text-2xl sm:text-3xl font-bold text-gray-900 tracking-tight mt-12 mb-4","children":"What is a Bath Fitter-style bathroom renovation?"}],["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["In this article, “Bath Fitter-style” describes a surface-led bathroom update using items such as wall panels, replacement bath or shower components, and fittings installed around parts of the existing bathroom. This approach can retain some of the existing plumbing and layout, whereas a full bathroom renovation may involve stripping back the room, altering services, tiling and fitting new sanitaryware."]}],["$","h3",null,{"className":"font-display text-xl sm:text-2xl font-bold text-gray-900 tracking-tight mt-8 mb-3","children":"Typical UK cost ranges"}],["$","aside",null,{"className":"my-10 rounded-2xl bg-gradient-to-br from-gray-900 via-gray-800 to-gray-900 p-6 sm:p-8 border border-[#C8A97E]/30","children":[["$","h3",null,{"className":"font-display text-xl sm:text-2xl font-bold text-white tracking-tight mb-2","children":"Thinking about your own project?"}],["$","p",null,{"className":"text-white/70 text-sm sm:text-base leading-relaxed mb-5","children":["BMB Renovation covers Watford, Bushey, Rickmansworth, St Albans, Hemel Hempstead and beyond — all trades in-house. Call +44 7775 758 717 or send us a message."]}],["$","$L4",null,{"href":"/contact","className":"inline-flex items-center gap-2 px-6 py-3 rounded-full bg-[#C8A97E] text-white text-sm font-bold hover:bg-[#b39668] transition-colors","children":["Get a Free Quote",["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right w-4 h-4","children":[["$","path","1ays0h",{"d":"M5 12h14"}],["$","path","xquz4c",{"d":"m12 5 7 7-7 7"}],"$undefined"]}]]}]]}],["$","ul",null,{"className":"my-5 space-y-2.5","children":[["$","li","0",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["As a rough guide, a limited bath or shower-area refresh may typically cost around £2,000 to £5,000, depending on the materials, fixtures, access and installation requirements."]}]]}],["$","li","1",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["As a rough guide, replacing a bath or shower, wall finish, taps and associated fittings may typically cost around £3,000 to £7,000 where the existing layout and services can be retained."]}]]}],["$","li","2",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["As a rough guide, a more complete bathroom renovation may typically start at around £6,000 and reach £12,000 or more, depending on the room, labour, access and material choices."]}]]}],["$","li","3",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Premium sanitaryware, made-to-measure panels, concealed plumbing, electrical changes, structural repairs or difficult access can move the price beyond these broad ranges."]}]]}]]}],["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["These figures are only rough UK guide prices, not fixed tariffs, and every project differs. A small bathroom with sound walls and straightforward access may cost less than a larger room needing repairs, while a simple-looking makeover can become more expensive if the bath, floor or pipework is damaged. The most useful comparison is between like-for-like written quotes that list products, preparation, labour, waste removal and any exclusions. Request a free, no-obligation quote for accurate pricing for your room."]}],["$","h2",null,{"className":"font-display text-2xl sm:text-3xl font-bold text-gray-900 tracking-tight mt-12 mb-4","children":"What changes the cost before and after?"}],["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["Before photographs may show stained sealant, cracked tiles, dated panels, worn flooring or a bath that is difficult to clean. After photographs may show refreshed wall surfaces, new sealant, updated taps, improved storage and a cleaner shower or bath area. The visual difference can be substantial, but the work behind that result varies. It is sensible to inspect what is underneath the visible finish rather than pricing solely from photographs."]}],["$","ul",null,{"className":"my-5 space-y-2.5","children":[["$","li","0",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["The condition of the substrate: damp, mould, damaged flooring or unstable walls may need to be repaired before panels, tiles or sanitaryware are fitted."]}]]}],["$","li","1",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["The chosen finish: wall panels, large-format tiles, ceramic tiles, stone-effect products and bespoke surfaces can have different material and fitting costs."]}]]}],["$","li","2",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Plumbing changes: keeping the bath, toilet and basin in the same positions is usually simpler than moving waste pipes, water supplies or a shower enclosure."]}]]}],["$","li","3",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Electrical work: new lighting, an extractor fan, shaver socket or electric shower may require additional work."]}]]}],["$","li","4",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Access and removal: upper-floor bathrooms, narrow staircases, parking restrictions and disposal of old fittings can affect labour and logistics."]}]]}],["$","li","5",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["The amount of joinery: vanity units, boxing-in, shelving, storage and made-to-measure panels add materials and installation time."]}]]}]]}],["$","h2",null,{"className":"font-display text-2xl sm:text-3xl font-bold text-gray-900 tracking-tight mt-12 mb-4","children":"Is the quicker approach right for your bathroom?"}],["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["A Bath Fitter-style approach may suit a homeowner who wants to improve a tired bath or shower area, reduce the amount of demolition, keep the existing layout or complete a practical update without a full redesign. It may be an option when the plumbing is serviceable and the surrounding walls and floor are sound. It can also be considered for a property being prepared for sale or rent where a clean, coordinated finish is the priority."]}],["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["It may be less suitable when there is persistent damp, movement in the walls, failing pipework, poor ventilation or a floor affected by leaks. Covering an underlying problem does not remove it. A full strip-out may be more appropriate if you want to change the room layout, install underfloor heating, add substantial storage or replace most of the fittings. In those cases, a partial makeover first may mean paying again for preparation and removal."]}],["$","h2",null,{"className":"font-display text-2xl sm:text-3xl font-bold text-gray-900 tracking-tight mt-12 mb-4","children":"How to compare a Bath Fitter quote with a full renovation quote"}],["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["Ask each installer to describe exactly what will be removed, what will remain and how the surfaces will be prepared. Check whether the quote includes the bath or shower tray, wall system, taps, screen, waste fittings, sealant, flooring, lighting, ventilation, delivery, waste disposal and making good. Also ask who deals with plumbing, tiling and electrical work, and whether those trades are included or priced separately."]}],["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["For a broader comparison, review the scope of a ",["$","$L4","0",{"href":"/bathroom-renovation-watford","className":"text-[#C8A97E] font-medium underline decoration-[#C8A97E]/40 underline-offset-2 hover:decoration-[#C8A97E] transition-colors","children":"bathroom renovation in Watford"}]," alongside a limited replacement quote. Comparing both options can help you assess the cost of retaining the existing layout against changing it. BMB Renovation provides bathroom fitting and renovation services, with all plumbing, tiling, electrical and cabinet installation work handled in-house. Homeowners can request a ",["$","$L4","1",{"href":"/contact","className":"text-[#C8A97E] font-medium underline decoration-[#C8A97E]/40 underline-offset-2 hover:decoration-[#C8A97E] transition-colors","children":"free, no-obligation quote"}]," based on the actual room rather than a generic online estimate."]}],["$","h2",null,{"className":"font-display text-2xl sm:text-3xl font-bold text-gray-900 tracking-tight mt-12 mb-4","children":"Questions to ask before choosing an installer"}],["$","ul",null,{"className":"my-5 space-y-2.5","children":[["$","li","0",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Will the existing bath, shower, wall and floor be inspected for leaks, damp or movement before the price is confirmed?"]}]]}],["$","li","1",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Is the quoted price fixed, and what circumstances could lead to additional costs?"]}]]}],["$","li","2",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Are removal, waste disposal, preparation, plumbing, electrical work, tiling and final sealing included?"]}]]}],["$","li","3",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["How will the new panels or tiles be joined around corners, windows, pipes and fittings?"]}]]}],["$","li","4",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["What happens if damaged plaster, flooring or pipework is discovered after the old fittings are removed?"]}]]}],["$","li","5",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Can the installer explain the expected timescale and how the bathroom will be protected during the work?"]}]]}]]}],["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["The best choice depends less on the label used and more on the condition of the room, the finish you want and how long you plan to stay in the property. Compare the visible before-and-after result with the hidden work required to achieve it. A lower initial quote is not necessarily better value if it excludes repairs, preparation or essential services."]}],["$","aside",null,{"className":"my-10 rounded-2xl bg-gradient-to-br from-gray-900 via-gray-800 to-gray-900 p-6 sm:p-8 border border-[#C8A97E]/30","children":[["$","h3",null,{"className":"font-display text-xl sm:text-2xl font-bold text-white tracking-tight mb-2","children":"Get a Free, No-Obligation Quote"}],["$","p",null,{"className":"text-white/70 text-sm sm:text-base leading-relaxed mb-5",