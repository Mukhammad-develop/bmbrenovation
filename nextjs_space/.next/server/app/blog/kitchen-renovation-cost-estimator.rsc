,{"d":"M16 2v4"}],["$","rect","1hopcy",{"width":"18","height":"18","x":"3","y":"4","rx":"2"}],["$","path","8toen8",{"d":"M3 10h18"}],"$undefined"]}],"5 August 2026",["$","span",null,{"className":"text-white/25","children":"·"}],["$","span",null,{"children":"BMB Renovation"}]]}]]}]}],["$","article",null,{"className":"py-14 sm:py-20 flex-grow bg-gray-50","children":["$","div",null,{"className":"max-w-[800px] mx-auto px-4 sm:px-6","children":["$","div",null,{"className":"bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10","children":[["$","div",null,{"children":[["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["A kitchen renovation cost estimator is useful for setting a realistic budget before you choose units, appliances or finishes. In the UK, the total can vary considerably: replacing doors and worktops is a very different project from moving walls, renewing electrics and plumbing, and fitting a completely new kitchen. This guide breaks the cost into the main parts so homeowners in Hertfordshire, North London and Bedfordshire can compare options and ask for a more accurate local quote."]}],["$","h2",null,{"className":"font-display text-2xl sm:text-3xl font-bold text-gray-900 tracking-tight mt-12 mb-4","children":"How to use a kitchen renovation cost estimator"}],["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["Start with the size and layout of the room, then list each cost category separately. As a rough UK planning guide, a straightforward small or medium kitchen renovation might typically cost around £8,000 to £20,000, while a larger or more customised project may exceed £25,000. Every project differs, so these are broad planning figures rather than quotations; get a free, no-obligation quote for accurate pricing. The final price depends on the number of units, chosen materials, appliance specification, access to the property, preparation work and whether VAT is included in the figures you receive."]}],["$","ul",null,{"className":"my-5 space-y-2.5","children":[["$","li","0",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Cabinetry: the number of cupboards, drawers, tall units, corner solutions and any bespoke storage."]}]]}],["$","li","1",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Worktops and splashbacks: material, thickness, cut-outs, joints and upstands."]}]]}],["$","li","2",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Appliances: integrated or freestanding models, extraction, installation and disposal of old appliances."]}]]}],["$","li","3",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Fitting: removal, preparation, cabinet installation, worktops, plumbing, electrics, tiling and decorating."]}]]}],["$","li","4",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Structural work: walls, windows, doors, flooring, ceilings, gas or plumbing alterations and electrical upgrades."]}]]}],["$","li","5",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Additional costs: delivery, waste removal, building control where applicable, and VAT if it is not already included."]}]]}]]}],["$","aside",null,{"className":"my-10 rounded-2xl bg-gradient-to-br from-gray-900 via-gray-800 to-gray-900 p-6 sm:p-8 border border-[#C8A97E]/30","children":[["$","h3",null,{"className":"font-display text-xl sm:text-2xl font-bold text-white tracking-tight mb-2","children":"Thinking about your own project?"}],["$","p",null,{"className":"text-white/70 text-sm sm:text-base leading-relaxed mb-5","children":["BMB Renovation covers Watford, Bushey, Rickmansworth, St Albans, Hemel Hempstead and beyond — all trades in-house. Call +44 7775 758 717 or send us a message."]}],["$","$L4",null,{"href":"/contact","className":"inline-flex items-center gap-2 px-6 py-3 rounded-full bg-[#C8A97E] text-white text-sm font-bold hover:bg-[#b39668] transition-colors","children":["Get a Free Quote",["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right w-4 h-4","children":[["$","path","1ays0h",{"d":"M5 12h14"}],["$","path","xquz4c",{"d":"m12 5 7 7-7 7"}],"$undefined"]}]]}]]}],["$","h2",null,{"className":"font-display text-2xl sm:text-3xl font-bold text-gray-900 tracking-tight mt-12 mb-4","children":"Cabinets, worktops and storage"}],["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["Cabinets are often a significant product cost. Flat-pack and entry-level ranges may suit a tight budget, while rigid, made-to-measure or bespoke units generally cost more. As a rough UK guide, units for a simple run of cabinets might typically cost around £2,000 to £6,000, while a larger kitchen with tall housings, an island, internal storage and premium finishes may cost £10,000 or more. Every project differs, so obtain a free, no-obligation quote for accurate pricing. Check whether doors, handles, plinths, end panels, fillers and internal drawers are included, as these items can be left out of an initial headline price."]}],["$","h3",null,{"className":"font-display text-xl sm:text-2xl font-bold text-gray-900 tracking-tight mt-8 mb-3","children":"Worktop costs can change the estimate quickly"}],["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["Laminate is often a lower-cost worktop option. As a rough UK allowance, it may typically cost around £500 to £1,500 for many standard kitchens. Timber, solid-surface, quartz and natural stone may typically range from around £1,500 to £5,000 or more, depending on the area, edge detail and number of cut-outs. Every project differs, so get a free, no-obligation quote for accurate pricing. Sink and hob openings, joints, drainer grooves and templating may be charged separately. If you are comparing estimates, make sure every quote describes the same worktop material and includes fitting."]}],["$","h3",null,{"className":"font-display text-xl sm:text-2xl font-bold text-gray-900 tracking-tight mt-8 mb-3","children":"Allow separately for appliances"}],["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["As a rough UK guide, appliances may typically add around £1,500 to £6,000 to a kitchen budget, although premium or specialist choices can cost more. Every project differs, so get a free, no-obligation quote for accurate pricing. A typical list may include an oven, hob, extractor, fridge-freezer, dishwasher and washing machine. Integrated appliances can require additional housing panels and careful coordination with the cabinet layout. Ask whether delivery, connection, testing and removal of existing appliances are included. Electrical or gas connections should be carried out by suitably qualified professionals, with the necessary documentation provided where relevant."]}],["$","h2",null,{"className":"font-display text-2xl sm:text-3xl font-bold text-gray-900 tracking-tight mt-12 mb-4","children":"Kitchen fitting and installation costs"}],["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["As a rough UK guide, fitting for a standard kitchen might typically cost around £3,000 to £7,000, but the range is wide because the scope can include more than placing cabinets in position. Every project differs, so get a free, no-obligation quote for accurate pricing. A detailed quote should identify removal of the old kitchen, protection of floors and surfaces, assembly, levelling, scribing, worktop fitting, appliance installation, plumbing, electrical work, tiling, flooring and decorating. A kitchen with a simple replacement layout is usually less labour-intensive than one where services must be moved or several trades need to work in sequence."]}],["$","h2",null,{"className":"font-display text-2xl sm:text-3xl font-bold text-gray-900 tracking-tight mt-12 mb-4","children":"Structural work and hidden preparation"}],["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["Structural changes can make an estimator less reliable until the property has been assessed. Removing a partition, creating an opening, moving a doorway or altering a window can add substantially to the budget, particularly where structural design, approvals or specialist work are needed. You may also need to allow for floor repairs, damp or uneven walls, new plasterboard, upgraded circuits, additional sockets, ventilation, plumbing runs, heating changes or ceiling repairs. Before accepting a fixed price, ask who is responsible for investigating hidden defects and how unexpected work will be priced."]}],["$","h2",null,{"className":"font-display text-2xl sm:text-3xl font-bold text-gray-900 tracking-tight mt-12 mb-4","children":"How to obtain an accurate local kitchen quote"}],["$","ul",null,{"className":"my-5 space-y-2.5","children":[["$","li","0",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Provide measurements, photographs and a simple plan showing doors, windows, radiators, boiler locations, water points and existing sockets."]}]]}],["$","li","1",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Explain whether the layout is staying the same or whether you want an island, changed appliances, moved plumbing or removed walls."]}]]}],["$","li","2",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Choose a specification before comparing prices: cabinet range, worktop, handles, sink, tap, appliances, flooring, splashback and lighting."]}]]}],["$","li","3",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Ask for labour, materials, delivery, waste disposal, preparation and VAT to be shown clearly rather than relying on one total."]}]]}],["$","li","4",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Confirm the programme and who coordinates the different trades. BMB Renovation is based at 157 Judge Street, Watford WD24 5AN, and handles plumbing, tiling, electrical and cabinet installation work in-house."]}]]}],["$","li","5",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Obtain a written, no-obligation quotation after a site visit wherever possible. BMB Renovation offers free, no-obligation quotes for homeowners in Watford, Bushey, Rickmansworth, St Albans, Hemel Hempstead, Borehamwood, Harrow, Croxley Green, Luton and Bedford."]}]]}]]}],["$","aside",null,{"className":"my-10 rounded-2xl bg-gradient-to-br from-gray-900 via-gray-800 to-gray-900 p-6 sm:p-8 border border-[#C8A97E]/30","children":[["$","h3",null,{"className":"font-display text-xl sm:text-2xl font-bold text-white tracking-tight mb-2","children":"Get a Free, No-Obligation Quote"}],["$","p",null,{"className":"text-white/70 text-sm sm:text-base leading-relaxed mb-5","children":["BMB Renovation handles kitchens, bathrooms and full home renovations across Watford, Hertfordshire, North London & Bedfordshire — all trades in-house. Tell us about your project today."]}],["$","$L4",null,{"href":"/contact","className":"inline-flex items-center gap-2 px-6 py-3 rounded-full bg-[#C8A97E] text-white text-sm font-bold hover:bg-[#b39668] transition-colors","children":["Get My Free Quote",["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right w-4 h-4","children":[["$","path","1ays0h",{"d":"M5 12h14"}],["$","path","xquz4c",{"d":"m12 5 7 7-7 7"}],"$undefined"]}]]}]]}]]}],["$","section",null,{"className":"mt-14","children":[["$","div",null,{"className":"flex items-center gap-2.5 mb-6","children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle-help w-6 h-6 text-[#C8A97E]","children":[["$","circle","1mglay",{"cx":"12","cy":"12","r":"10"}],["$","path","1u773s",{"d":"M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"}],["$","path","p32p05",{"d":"M12 17h.01"}],"$undefined"]}],["$","h2",null,{"className":"font-display text-2xl sm:text-3xl font-bold text-gray-900 tracking-tight","children":"Frequently Asked Questions"}]]}],["$","div",null,{"className":"space-y-3","children":[["$"