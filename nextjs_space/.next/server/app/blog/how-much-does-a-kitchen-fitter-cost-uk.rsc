ath","4m81vk",{"d":"M16 2v4"}],["$","rect","1hopcy",{"width":"18","height":"18","x":"3","y":"4","rx":"2"}],["$","path","8toen8",{"d":"M3 10h18"}],"$undefined"]}],"11 August 2026",["$","span",null,{"className":"text-white/25","children":"·"}],["$","span",null,{"children":"BMB Renovation"}]]}]]}]}],["$","article",null,{"className":"py-14 sm:py-20 flex-grow bg-gray-50","children":["$","div",null,{"className":"max-w-[800px] mx-auto px-4 sm:px-6","children":["$","div",null,{"className":"bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10","children":[["$","div",null,{"children":[["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["If you are budgeting for a new kitchen, one of the first questions is: how much does a kitchen fitter cost in the UK? The answer depends on the size and layout of the room, the condition of the existing services and how much work is involved beyond installing the cabinets. As a rough guide, kitchen fitting labour can range from around £1,500 for a straightforward small installation to £10,000 or more for a complex renovation. These figures are estimates only; every kitchen is different, so get a free, no-obligation quote for accurate pricing."]}],["$","h2",null,{"className":"font-display text-2xl sm:text-3xl font-bold text-gray-900 tracking-tight mt-12 mb-4","children":"What is the typical cost of a kitchen fitter in the UK?"}],["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["For labour only, a kitchen fitter may charge a day rate of roughly £200 to £350, although rates vary by location, experience, the type of work required and whether additional trades are included. A small, uncomplicated kitchen may take several days, while a larger room with new flooring, tiling, plumbing, electrics and bespoke carpentry can take considerably longer."]}],["$","ul",null,{"className":"my-5 space-y-2.5","children":[["$","li","0",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Small or straightforward kitchen installation: roughly £1,500 to £3,000 in labour"]}]]}],["$","li","1",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Medium kitchen refit with several trades: roughly £3,000 to £6,000 in labour"]}]]}],["$","li","2",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Large or complex kitchen renovation: around £6,000 to £10,000 or more in labour"]}]]}]]}],["$","aside",null,{"className":"my-10 rounded-2xl bg-gradient-to-br from-gray-900 via-gray-800 to-gray-900 p-6 sm:p-8 border border-[#C8A97E]/30","children":[["$","h3",null,{"className":"font-display text-xl sm:text-2xl font-bold text-white tracking-tight mb-2","children":"Thinking about your own project?"}],["$","p",null,{"className":"text-white/70 text-sm sm:text-base leading-relaxed mb-5","children":["BMB Renovation covers Watford, Bushey, Rickmansworth, St Albans, Hemel Hempstead and beyond — all trades in-house. Call +44 7775 758 717 or send us a message."]}],["$","$L4",null,{"href":"/contact","className":"inline-flex items-center gap-2 px-6 py-3 rounded-full bg-[#C8A97E] text-white text-sm font-bold hover:bg-[#b39668] transition-colors","children":["Get a Free Quote",["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right w-4 h-4","children":[["$","path","1ays0h",{"d":"M5 12h14"}],["$","path","xquz4c",{"d":"m12 5 7 7-7 7"}],"$undefined"]}]]}]]}],["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["These are broad UK guide prices rather than fixed tariffs. Every project differs, so get a free, no-obligation quote for accurate pricing. A quote may or may not include VAT, waste removal, delivery coordination or specialist items such as worktop fabrication, so it is important to ask what is covered before comparing quotes. A lower headline figure is not necessarily better value if key tasks have been left out."]}],["$","h2",null,{"className":"font-display text-2xl sm:text-3xl font-bold text-gray-900 tracking-tight mt-12 mb-4","children":"What does kitchen fitting labour usually include?"}],["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["A kitchen fitter’s core work normally includes assembling and positioning base and wall units, levelling cabinets, fitting doors and drawers, installing plinths and panels, and fitting worktops where the material and design allow. The installer may also fit sinks, taps, appliances and handles, but these items should be listed clearly in the quotation rather than assumed."]}],["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["A full kitchen renovation often involves more than cabinet installation. Depending on the project, the labour may also cover removing the old kitchen, preparing walls and floors, adjusting plumbing, installing or altering electrical points, fitting lighting, tiling, decorating and laying flooring. BMB Renovation handles all plumbing, tiling, electrical and cabinet installation work in-house. You can review the available ",["$","$L4","0",{"href":"/kitchen-fitting-watford","className":"text-[#C8A97E] font-medium underline decoration-[#C8A97E]/40 underline-offset-2 hover:decoration-[#C8A97E] transition-colors","children":"kitchen fitting services in Watford"}]," to see how a fitting project can be approached as part of a wider renovation."]}],["$","h3",null,{"className":"font-display text-xl sm:text-2xl font-bold text-gray-900 tracking-tight mt-8 mb-3","children":"Items that may be charged separately"}],["$","ul",null,{"className":"my-5 space-y-2.5","children":[["$","li","0",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Supply of cabinets, doors, handles, worktops and accessories"]}]]}],["$","li","1",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Appliances, sinks, taps, extractor fans and lighting"]}]]}],["$","li","2",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Specialist worktop cutting, particularly for stone or composite materials"]}]]}],["$","li","3",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Skip hire, rubbish removal and delivery or storage"]}]]}],["$","li","4",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Making good after removal, including plastering, flooring or decorating"]}]]}],["$","li","5",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Building control, design, structural or specialist contractor fees where applicable"]}]]}]]}],["$","h2",null,{"className":"font-display text-2xl sm:text-3xl font-bold text-gray-900 tracking-tight mt-12 mb-4","children":"What can increase the final kitchen fitting quote?"}],["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["The biggest cost difference often comes from the amount of preparation and alteration required. Replacing cabinets in the same positions is generally less labour-intensive than changing the layout. Moving a sink, dishwasher, cooker or radiator can involve alterations to water, waste, gas or electrical connections. If the existing walls or floor are uneven, extra preparation may be needed before cabinets and worktops can be installed accurately."]}],["$","ul",null,{"className":"my-5 space-y-2.5","children":[["$","li","0",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Changing the kitchen layout or removing walls, subject to the appropriate checks"]}]]}],["$","li","1",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Moving plumbing, drainage, gas supplies or electrical sockets"]}]]}],["$","li","2",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Upgrading the consumer unit, wiring or lighting arrangements where required"]}]]}],["$","li","3",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Uneven floors, damaged plaster, damp or poorly prepared walls"]}]]}],["$","li","4",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Large-format tiles, intricate patterns or extensive wall tiling"]}]]}],["$","li","5",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Stone, quartz or other worktops needing templates and specialist cutting"]}]]}],["$","li","6",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Bespoke units, awkward corners, alcoves or limited access to the property"]}]]}],["$","li","7",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Additional joinery, built-in storage, panelling or finishing work"]}]]}],["$","li","8",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Working around occupied rooms, restricted parking or difficult material access"]}]]}]]}],["$","h2",null,{"className":"font-display text-2xl sm:text-3xl font-bold text-gray-900 tracking-tight mt-12 mb-4","children":"How to compare kitchen fitter quotes fairly"}],["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["Ask each kitchen fitter for an itemised quotation that separates labour, materials, appliances and any subcontracted or specialist work. The quote should describe the number of units, worktop installation, appliance connections, tiling, flooring, decorating, removal of the old kitchen and waste disposal. It should also state whether VAT is included and identify any provisional sums or allowances."]}],["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["A site visit can be useful because a remote estimate may not reveal access problems, hidden pipework or the condition behind existing cabinets. Before work begins, confirm the expected start date, estimated duration, payment stages, responsibility for ordering materials and what happens if unforeseen work is discovered. If you are planning a more extensive project in the Watford area, you can ",["$","$L4","0",{"href":"/contact","className":"text-[#C8A97E] font-medium underline decoration-[#C8A97E]/40 underline-offset-2 hover:decoration-[#C8A97E] transition-colors","children":"request a free, no-obligation quote"}]," after the scope has been discussed."]}],["$","h2",null,{"className":"font-display text-2xl sm:text-3xl font-bold text-gray-900 tracking-tight mt-12 mb-4","children":"Ways to keep kitchen fitting costs under control"}],["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["Keeping the existing layout is often one of the simplest ways to reduce labour, particularly when the plumbing and electrical points are already suitable. Finalise your cabinet plan, appliance sizes, sink position and worktop choice before installation starts. Last-minute changes can cause delays, additional deliveries and remedial work."]}],["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["You can also ask whether the fitter can complete several connected tasks as one coordinated project, rather than arranging separate trades yourself. However, do not reduce costs by overlooking essential preparation or using unsuitable materials. Correctly levelling cabinets, sealing worktops and arranging appropriate service connections are important parts of a durable kitchen installation."]}],["$","h2",null,{"className":"font-display text-2xl sm:text-3xl font-bold text-gray-900 tracking-tight mt-12 mb-4","children":"Finding the right kitchen fitter"}],["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["Look for a clear written scope of work, realistic timings and evidence that the installer understands both cabinet fitting and the supporting trades your kitchen needs. For homeowners in Hertfordshire, North London and Bedfordshire, BMB Renovation is based at 157 Judge Street, Watford WD24 5AN and offers kitchen fitting and renovation services across Watford, Bushey, Rickmansworth, St Albans, Hemel Hempstead, Borehamwood, Harrow, Croxley Green, Luton and Bedford. The team can be contacted on +44 7775 758 717 or at contact@bmbrenovation.co.uk."]}],["$","aside",null,{"className":"my-10 rounded-2xl bg-gradient-to-br from-gray-900 via-gray-800 to-gray-900 p-6 sm:p-8 border border-[#C8A97E]/30","children":[["$","h3",null,{"className":"font-display text-xl sm:text-2xl font-bold text-white tracking-tight mb-2","children":"Get a Free, No-Obligation Quote"}],["$","p",null,{"className":"text-white/70 text-sm sm:text-base leading-relaxed mb-5","children":["BMB Renovation handles kitchens, bathrooms and full home renovations across Watford, Hertfordshire, North London & Bedfordshire — all trades in-house. Tell us about your project today."]}],["$","$L4",null,{"href":"/contact","className":"inline-flex items-center gap-2 px-6 py-3 rounded-full bg-[#C8A97E] text-white text-sm font-bold hover:bg-[#b39668] transition-colors","children":["Get My Free Quote",["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right w-4 h-4","children":[["$","path","1ays0h",{"d":"M5 12h14"}],["$","path","xquz4c",{"d":"m12 5 7 7-7 7"}],"$undefined"]}]]}]]}]]}],["$","section",null,{"className":"mt-14","children":[["$","div",null,{"className":"flex items-center gap-2.5 mb-6","children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle-help w-6 h-6 text-[#C8A97E]","children":[["$","circle","1mgla