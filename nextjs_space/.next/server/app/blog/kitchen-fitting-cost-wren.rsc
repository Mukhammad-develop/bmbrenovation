th":"18","height":"18","x":"3","y":"4","rx":"2"}],["$","path","8toen8",{"d":"M3 10h18"}],"$undefined"]}],"2 August 2026",["$","span",null,{"className":"text-white/25","children":"·"}],["$","span",null,{"children":"BMB Renovation"}]]}]]}]}],["$","article",null,{"className":"py-14 sm:py-20 flex-grow bg-gray-50","children":["$","div",null,{"className":"max-w-[800px] mx-auto px-4 sm:px-6","children":["$","div",null,{"className":"bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10","children":[["$","div",null,{"children":[["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["If you are comparing kitchen suppliers, the kitchen fitting cost with Wren may be as important as the price of the cabinets and worktops. Check whether the supplier's quotation separates the kitchen supply from installation, and review exactly what is included. The final fitting cost can depend on the size and shape of the room, the number of units, your chosen appliances and any work needed before installation. There is no single price that applies to every kitchen project, so treat any fitting figure as a project-specific estimate rather than a standard rate."]}],["$","h2",null,{"className":"font-display text-2xl sm:text-3xl font-bold text-gray-900 tracking-tight mt-12 mb-4","children":"How much does Wren kitchen fitting cost?"}],["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["Ask Wren for a current installation quotation based on your design and the work identified for your room. Costs can be affected by whether you are replacing an existing kitchen in the same layout or moving sinks, appliances and services. A simple installation with sound walls, level floors and little alteration is usually less involved than a full kitchen renovation requiring plumbing, electrical work, plastering, flooring or tiling. As a rough guide, UK kitchen fitting and associated installation work can typically cost several thousand pounds, depending on the scope. Every project differs, so obtain a free, no-obligation quote for accurate pricing. Check separately whether units, appliances, worktops and accessories are included in any installation figure."]}],["$","h3",null,{"className":"font-display text-xl sm:text-2xl font-bold text-gray-900 tracking-tight mt-8 mb-3","children":"What is usually included in the fitting service?"}],["$","aside",null,{"className":"my-10 rounded-2xl bg-gradient-to-br from-gray-900 via-gray-800 to-gray-900 p-6 sm:p-8 border border-[#C8A97E]/30","children":[["$","h3",null,{"className":"font-display text-xl sm:text-2xl font-bold text-white tracking-tight mb-2","children":"Thinking about your own project?"}],["$","p",null,{"className":"text-white/70 text-sm sm:text-base leading-relaxed mb-5","children":["BMB Renovation covers Watford, Bushey, Rickmansworth, St Albans, Hemel Hempstead and beyond — all trades in-house. Call +44 7775 758 717 or send us a message."]}],["$","$L4",null,{"href":"/contact","className":"inline-flex items-center gap-2 px-6 py-3 rounded-full bg-[#C8A97E] text-white text-sm font-bold hover:bg-[#b39668] transition-colors","children":["Get a Free Quote",["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right w-4 h-4","children":[["$","path","1ays0h",{"d":"M5 12h14"}],["$","path","xquz4c",{"d":"m12 5 7 7-7 7"}],"$undefined"]}]]}]]}],["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["The exact scope should be confirmed in writing. Kitchen installation may involve assembling and securing cabinets, fitting doors and drawers, installing worktops and connecting appliances or sinks where agreed. Removal of an old kitchen may be available as an additional service. Plumbing, electrical and finishing work can be included, excluded or separately priced depending on the quotation. Do not assume that every task needed to make the room fully usable is included simply because the quotation is described as kitchen fitting."]}],["$","ul",null,{"className":"my-5 space-y-2.5","children":[["$","li","0",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Cabinet assembly, positioning and levelling."]}]]}],["$","li","1",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Fitting doors, drawers, handles, plinths and panels."]}]]}],["$","li","2",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Worktop installation, subject to the material and agreed fitting method."]}]]}],["$","li","3",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Connection of appliances or sinks where included in the written scope."]}]]}],["$","li","4",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Removal of existing units, flooring or waste only when specifically priced."]}]]}],["$","li","5",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Making good, decorating, tiling and flooring, which may be included or charged separately."]}]]}]]}],["$","h2",null,{"className":"font-display text-2xl sm:text-3xl font-bold text-gray-900 tracking-tight mt-12 mb-4","children":"Potential extra charges to check before agreeing"}],["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["Preparation work identified after the old kitchen is removed can add labour and material costs. Uneven floors, damp, damaged plaster, unsuitable walls or outdated services may need attention before fitting can continue. Moving a sink, dishwasher, cooker or washing machine can require changes to plumbing or electrical routes. A new layout may also require plastering, flooring, tiling, lighting or decorating. Ask for likely exclusions and how any additional work will be approved before it starts."]}],["$","ul",null,{"className":"my-5 space-y-2.5","children":[["$","li","0",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Removing and disposing of the old kitchen, appliances or rubble."]}]]}],["$","li","1",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Moving or upgrading plumbing, waste pipes and electrical points."]}]]}],["$","li","2",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Gas-related work, where applicable, carried out by an appropriately qualified professional."]}]]}],["$","li","3",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Extra worktops, upstands, end panels, filler panels or decorative pieces."]}]]}],["$","li","4",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Cut-outs, joins and specialist installation for stone, quartz or other demanding worktop materials."]}]]}],["$","li","5",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Floor levelling, new flooring, wall repairs, plastering, tiling and painting."]}]]}],["$","li","6",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Alterations caused by missing, damaged or incorrect components."]}]]}],["$","li","7",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Additional visits or labour if the room, services or delivered items are not ready."]}]]}]]}],["$","h2",null,{"className":"font-display text-2xl sm:text-3xl font-bold text-gray-900 tracking-tight mt-12 mb-4","children":"Questions to ask about a Wren installation quotation"}],["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["Before comparing a Wren fitting cost with an independent quote, ask for an itemised breakdown. Check whether VAT is included, what happens to the old kitchen, who removes packaging and waste, and whether appliance connections are covered. Ask how damaged or missing parts will be handled and whether the installation price can change if extra work is identified. It is also worth confirming the expected start date, estimated duration, payment stages and what you must arrange before the fitting team arrives. A low headline figure can be misleading if essential preparation is excluded."]}],["$","h3",null,{"className":"font-display text-xl sm:text-2xl font-bold text-gray-900 tracking-tight mt-8 mb-3","children":"When might an independent kitchen fitter offer better value?"}],["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["An independent fitter may offer better value when you want a more flexible scope of work or when the kitchen needs substantial alterations. You can compare detailed quotes and choose a contractor able to coordinate cabinet fitting with plumbing, electrics, tiling, flooring and decorating. This can be useful if you are not buying every component from one supplier, want to retain existing appliances or are combining a kitchen replacement with wider renovation work. The clarity of a quotation depends on the individual contractor, so compare the scope, labour, materials and preparation work carefully."]}],["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["The lowest independent quote is not automatically the best option. Confirm who will carry out each trade, whether waste removal is included, how variations are approved and what happens if a problem is found. Check that the fitter understands the installation requirements for your chosen cabinets, worktops and appliances. For homeowners in and around Watford, BMB Renovation provides ",["$","$L4","0",{"href":"/kitchen-fitting-watford","className":"text-[#C8A97E] font-medium underline decoration-[#C8A97E]/40 underline-offset-2 hover:decoration-[#C8A97E] transition-colors","children":"kitchen fitting in Watford"}],", with all plumbing, tiling, electrical and cabinet installation work handled in-house. This can make it easier to discuss the full room rather than pricing cabinet installation in isolation."]}],["$","h2",null,{"className":"font-display text-2xl sm:text-3xl font-bold text-gray-900 tracking-tight mt-12 mb-4","children":"Comparing Wren with a local renovation team"}],["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["A supplier installation package may suit homeowners who want the kitchen supply and fitting considered together. A local renovation company may be more suitable where the project involves a layout change, structural preparation or several finishing trades. BMB Renovation offers kitchen fitting and renovation, along with flooring, tiling, carpentry, painting and decorating and general handyman work. The company is based at 157 Judge Street, Watford WD24 5AN, and serves Watford, Bushey, Rickmansworth, St Albans, Hemel Hempstead, Borehamwood, Harrow, Croxley Green, Luton and Bedford. You can compare the scope with a supplier quotation by requesting a ",["$","$L4","0",{"href":"/contact","className":"text-[#C8A97E] font-medium underline decoration-[#C8A97E]/40 underline-offset-2 hover:decoration-[#C8A97E] transition-colors","children":"free, no-obligation quote"}],", but make sure both quotes describe the same work before comparing totals."]}],["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["The most useful comparison is a like-for-like schedule of work. List the cabinets, worktops, appliances, removal, plumbing, electrics, lighting, flooring, tiling, decorating, waste disposal and making good. Then mark each item as included, excluded or provisional. This can show whether a fitting cost is lower because important parts of the renovation have been left for you to organise. It also helps you plan a clearer budget before ordering materials or committing to a start date."]}],["$","aside",null,{"className":"my-10 rounded-2xl bg-gradient-to-br from-gray-900 via-gray-800 to-gray-900 p-6 sm:p-8 border border-[#C8A97E]/30","children":[["$","h3",null,{"className":"font-display text-xl sm:text-2xl font-bold text-white tracking-tight mb-2","children":"Get a Free, No-Obligation Quote"}],["$","p",null,{"className":"text-white/70 text-sm sm:text-base leading-relaxed mb-5","children":["BMB Renovation handles kitchens, bathrooms and full home renovations across Watford, Hertfordshire, North London & Bedfordshire — all trades in-house. Tell us 