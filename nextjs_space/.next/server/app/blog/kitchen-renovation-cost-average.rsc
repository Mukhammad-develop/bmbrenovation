2:T7e1,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"What is the average cost of a kitchen renovation in the UK?","acceptedAnswer":{"@type":"Answer","text":"As a rough guide, a professionally fitted kitchen renovation may typically cost around £8,000 to £25,000. Smaller cosmetic updates can cost less, while bespoke finishes, layout changes and structural work can take the total above £25,000. Every project differs, so get a free, no-obligation quote for accurate pricing."}},{"@type":"Question","name":"What is the cheapest way to renovate a kitchen?","acceptedAnswer":{"@type":"Answer","text":"Keeping the existing layout, retaining sound cabinets, replacing doors and handles, and choosing budget-friendly worktops and flooring may reduce costs. Check the condition of the underlying units and services before deciding what to retain."}},{"@type":"Question","name":"How much should I budget for kitchen fitting labour?","acceptedAnswer":{"@type":"Answer","text":"There is no reliable single percentage for kitchen fitting labour. The amount depends on the room, preparation, access, number of trades, materials and whether plumbing or electrics need moving. An itemised, project-specific quote is the best way to budget accurately."}},{"@type":"Question","name":"What is usually included in a full kitchen renovation?","acceptedAnswer":{"@type":"Answer","text":"A full renovation may include removal, preparation, cabinets, worktops, appliances, plumbing, electrical work, flooring, tiling, decorating and installation. Check each quotation carefully because inclusions vary between contractors."}},{"@type":"Question","name":"Should I keep a contingency for a kitchen renovation?","acceptedAnswer":{"@type":"Answer","text":"It can be sensible to keep a contingency for unexpected work, especially in older properties or where finishes are being removed. Hidden damage, uneven floors, outdated wiring and changes made during the project can affect the final cost."}}]}7:["slug","kitchen-renovation-cost-average","d"]
9:T4d5,{"@context":"https://schema.org","@type":"HomeAndConstructionBusiness","name":"BMB Renovation","url":"https://bmbrenovation.co.uk","logo":"https://bmbrenovation.co.uk/favicon.svg","image":"https://bmbrenovation.co.uk/og-image.png","description":"BMB Renovation offers premium home, kitchen & bathroom renovation services in Watford, London & Hertfordshire. 15+ years of experience. Free consultation.","telephone":"+447775758717","email":"contact@bmbrenovation.co.uk","priceRange":"££","address":{"@type":"PostalAddress","streetAddress":"157 Judge Street","addressLocality":"Watford","postalCode":"WD24 5AN","addressRegion":"Hertfordshire","addressCountry":"GB"},"geo":{"@type":"GeoCoordinates","latitude":51.6549,"longitude":-0.3978},"areaServed":["Watford","Bushey","Rickmansworth","St Albans","Hemel Hempstead","Borehamwood","Harrow","Croxley Green","Luton","Bedford","London"],"openingHoursSpecification":[{"@type":"OpeningHoursSpecification","dayOfWeek":["Monday","Tuesday","Wednesday","Thursday","Friday"],"opens":"08:00","closes":"18:00"},{"@type":"OpeningHoursSpecification","dayOfWeek":"Saturday","opens":"09:00","closes":"16:00"}],"sameAs":["https://www.facebook.com/bmbrenovation","https://www.instagram.com/bmbrenovation"]}0:["ZHolsKXsT59gV6Q137Cb6",[[["",{"children":["blog",{"children":[["slug","kitchen-renovation-cost-average","d"],{"children":["__PAGE__?{\"slug\":\"kitchen-renovation-cost-average\"}",{}]}]}]},"$undefined","$undefined",true],["",{"children":["blog",{"children":[["slug","kitchen-renovation-cost-average","d"],{"children":["__PAGE__",{},[["$L1",["$","div",null,{"className":"min-h-screen flex flex-col","children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Article\",\"headline\":\"Kitchen Renovation Cost Average: UK Guide\",\"description\":\"Kitchen renovation cost average explained by project scope, materials, labour and extras, with practical UK budgeting guidance for homeowners planning a refit.\",\"datePublished\":\"2026-08-06T12:24:46.349Z\",\"dateModified\":\"2026-08-06T12:24:46.349Z\",\"author\":{\"@type\":\"Organization\",\"name\":\"BMB Renovation\",\"url\":\"https://bmbrenovation.co.uk\"},\"publisher\":{\"@type\":\"Organization\",\"name\":\"BMB Renovation\",\"url\":\"https://bmbrenovation.co.uk\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://bmbrenovation.co.uk/og-image.png\"}},\"mainEntityOfPage\":\"https://bmbrenovation.co.uk/blog/kitchen-renovation-cost-average\",\"keywords\":\"average kitchen renovation cost UK, kitchen refurbishment cost, kitchen fitting cost, new kitchen budget, kitchen renovation labour costs\"}"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://bmbrenovation.co.uk\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Blog\",\"item\":\"https://bmbrenovation.co.uk/blog\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Kitchen Renovation Cost Average: UK Guide\",\"item\":\"https://bmbrenovation.co.uk/blog/kitchen-renovation-cost-average\"}]}"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$2"}}],["$","$L3",null,{}],["$","section",null,{"className":"relative pt-28 pb-12 bg-gradient-to-br from-gray-900 via-gray-800 to-gray-900","children":["$","div",null,{"className":"max-w-[800px] mx-auto px-4 sm:px-6","children":[["$","nav",null,{"className":"flex items-center gap-1.5 text-xs text-white/50 mb-6","aria-label":"Breadcrumb","children":[["$","$L4",null,{"href":"/","className":"hover:text-[#C8A97E] transition-colors inline-flex items-center gap-1","children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-house w-3.5 h-3.5","children":[["$","path","5wwlr5",{"d":"M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"}],["$","path","1d0kgt",{"d":"M3 10a2 2 0 0 1 .709-1.528l7-5.999a2 2 0 0 1 2.582 0l7 5.999A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"}],"$undefined"]}]," Home"]}],["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-right w-3 h-3","children":[["$","path","mthhwq",{"d":"m9 18 6-6-6-6"}],"$undefined"]}],["$","$L4",null,{"href":"/blog","className":"hover:text-[#C8A97E] transition-colors","children":"Blog"}],["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-right w-3 h-3","children":[["$","path","mthhwq",{"d":"m9 18 6-6-6-6"}],"$undefined"]}],["$","span",null,{"className":"text-white/80 truncate max-w-[200px] sm:max-w-none","children":"Kitchen Renovation Cost Average: UK Guide"}]]}],["$","div",null,{"className":"inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-white/10 border border-white/10 text-[#C8A97E] text-xs mb-4","children":"kitchen renovation cost average"}],["$","h1",null,{"className":"font-display text-3xl sm:text-4xl lg:text-5xl font-bold text-white tracking-tight leading-tight","children":"Kitchen Renovation Cost Average: UK Guide"}],["$","div",null,{"className":"flex items-center gap-2 text-white/50 text-sm mt-5","children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-calendar w-4 h-4","children":[["$","path","1cmpym",{"d":"M8 2v4"}],["$","path","4m81vk",{"d":"M16 2v4"}],["$","rect","1hopcy",{"width":"18","height":"18","x":"3","y":"4","rx":"2"}],["$","path","8toen8",{"d":"M3 10h18"}],"$undefined"]}],"6 August 2026",["$","span",null,{"className":"text-white/25","children":"·"}],["$","span",null,{"children":"BMB Renovation"}]]}]]}]}],["$","article",null,{"className":"py-14 sm:py-20 flex-grow bg-gray-50","children":["$","div",null,{"className":"max-w-[800px] mx-auto px-4 sm:px-6","children":["$","div",null,{"className":"bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10","children":[["$","div",null,{"children":[["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["If you are searching for the average cost of a kitchen renovation in the UK, there is no single price. A small cosmetic refresh can cost a few thousand pounds, while a full renovation involving new units, flooring, plumbing, electrics and structural changes can run into tens of thousands. As a rough guide, a professionally fitted kitchen renovation may typically cost between £8,000 and £25,000, although the size of the room, specification, location and amount of preparation required can move the figure considerably. Every project differs, so use these figures only for early planning and get a free, no-obligation quote for accurate pricing."]}],["$","h2",null,{"className":"font-display text-2xl sm:text-3xl font-bold text-gray-900 tracking-tight mt-12 mb-4","children":"Average kitchen renovation cost by project scope"}],["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["The most useful way to estimate your budget is to define the level of work required. A renovation that keeps the existing layout and services may cost less than one that changes the position of the sink, cooker or appliances. Labour availability, access to the property and the condition of the existing room can also affect the final price."]}],["$","ul",null,{"className":"my-5 space-y-2.5","children":[["$","li","0",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Cosmetic refresh: as a rough guide, typically £3,000 to £8,000. This may include repainting, replacing handles, updating worktops, fitting a new splashback, changing lighting or replacing selected appliances while keeping the existing cabinets and layout."]}]]}],["$","li","1",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Partial kitchen renovation: as a rough guide, typically £8,000 to £15,000. This may include new cabinet doors or cabinets, worktops, flooring, tiling and appliance upgrades, with limited changes to plumbing and electrics."]}]]}],["$","li","2",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Standard full renovation: as a rough guide, typically £15,000 to £25,000. This may cover units, worktops, appliances, flooring, decoration, plumbing, electrical work and installation, depending on the chosen materials and the work required."]}]]}],["$","li","3",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Higher-specification or complex renovation: typically £25,000 and upwards. Bespoke cabinetry, premium appliances, stone worktops, extensive electrical work, structural alterations or an open-plan redesign can increase the cost. Every project differs, so get a free, no-obligation quote for accurate pricing."]}]]}]]}],["$","aside",null,{"className":"my-10 rounded-2xl bg-gradient-to-br from-gray-900 via-gray-800 to-gray-900 p-6 sm:p-8 border border-[#C8A97E]/30","children":[["$","h3",null,{"className":"font-display text-xl sm:text-2xl font-bold text-white tracking-tight mb-2","children":"Thinking about your own project?"}],["$","p",null,{"className":"text-white/70 text-sm sm:text-base leading-relaxed mb-5","children":["BMB Renovation covers Watford, Bushey, Rickmansworth, St Albans, Hemel Hempstead and beyond — all trades in-house. Call +44 7775 758 717 or send us a message."]}],["$","$L4",null,{"href":"/contact","className":"inline-flex items-center gap-2 px-6 py-3 rounded-full bg-[#C8A97E] text-white text-sm font-bold hover:bg-[#b39668] transition-colors","children":["Get a Free Quote",["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right w-4 h-4","children":[["$","path","1ays0h",{"d":"M5 12h14"}],["$","path","xquz4c",{"d":"m12 5 7 7-7 7"}],"$undefined"]}]]}]]}],["$","h2",null,{"className":"font-display text-2xl sm:text-3xl font-bold text-gray-900 tracking-tight mt-12 mb-4","children":"What materials do to the overall budget"}],["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["Cabinetry can be one of the larger parts of a kitchen budget. Flat-pack units may reduce the initial material cost, while rigid, made-to-measure or bespoke cabinetry can cost more. The right choice depends on the shape of the room, the storage you need and how much adjustment is required during fitting. Replacing only doors and drawer fronts may be a way to change the appearance where the existing cabinet carcasses are sound."]}],["$","h3",null,{"className":"font-display text-xl sm:text-2xl font-bold text-gray-900 tracking-tight mt-8 mb-3","children":"Worktops, appliances and finishes"}],["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["Worktop material can make a noticeable difference to the budget. Laminate is often a lower-cost option, while solid timber, compact laminate, quartz and other stone surfaces can cost more depending on thickness, edge details, templating and installation. Appliance costs also vary widely: a basic oven, hob and extractor package may cost less than premium integrated appliances, an American-style fridge-freezer or specialist cooking equipment."]}],["$","ul",null,{"className":"my-5 space-y-2.5","children":[["$","li","0",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Cabinet doors, drawer fronts and handles: cost depends on whether you are refreshing existing units or replacing the full carcasses."]}]]}],["$","li","1",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Worktops: allow for the material, joins, cut-outs, edging and fitting, not just the price per metre."]}]]}],["$","li","2",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Appliances: compare the purchase price with delivery, installation, connection and disposal of the old appliance."]}]]}],["$","li","3",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Flooring: vinyl and laminate may be lower-cost choices, while porcelain tiles, natural stone and complex patterns can add material and labour costs."]}]]}],["$","li","4",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Splashbacks and wall tiling: budget for adhesive, grout, trims, preparation and any removal of existing finishes."]}]]}]]}],["$","h2",null,{"className":"font-display text-2xl sm:text-3xl font-bold text-gray-900 tracking-tight mt-12 mb-4","children":"How much of the cost is labour?"}],["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["Labour is not simply a charge for assembling cabinets. A kitchen renovation may involve removing the old kitchen, protecting the property, preparing walls and floors, fitting units, levelling worktops, connecting plumbing, completing electrical work, installing appliances, tiling and decorating. Labour and installation costs depend on the scope of work, preparation required, access, the number of trades involved and the complexity of the design. A simple replacement with no layout changes may need less labour than a renovation requiring multiple trades and extensive preparation."]}],["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["Ask for clarity about what the installation price includes. BMB Renovation provides kitchen fitting and renovation, with plumbing, tiling, electrical and cabinet installation work handled in-house. You can review the ",["$","$L4","0",{"href":"/kitchen-fitting-watford","className":"text-[#C8A97E] font-medium underline decoration-[#C8A97E]/40 underline-offset-2 hover:decoration-[#C8A97E] transition-colors","children":"kitchen fitting service in Watford"}]," or compare the wider ",["$","$L4","1",{"href":"/services","className":"text-[#C8A97E] font-medium underline decoration-[#C8A97E]/40 underline-offset-2 hover:decoration-[#C8A97E] transition-colors","children":"renovation services"}]," available for connected work such as flooring, carpentry and decorating."]}],["$","h2",null,{"className":"font-display text-2xl sm:text-3xl font-bold text-gray-900 tracking-tight mt-12 mb-4","children":"Common extras that can push up a kitchen budget"}],["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["The quoted price for units and fitting may not be the complete cost of a renovation. Existing conditions can become clearer when the old kitchen is removed, so it can be sensible to keep a contingency rather than allocating the entire budget to finishes. The appropriate contingency depends on the age and condition of the property, the amount of alteration planned and the level of uncertainty in the initial survey."]}],["$","ul",null,{"className":"my-5 space-y-2.5","children":[["$","li","0",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Removal and disposal of the old kitchen, including cabinets, worktops, flooring and redundant appliances."]}]]}],["$","li","1",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Moving water, waste, gas or electrical points to suit a new layout."]}]]}],["$","li","2",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Electrical upgrades, additional sockets or improved task and under-cabinet lighting."]}]]}],["$","li","3",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Floor levelling, damp repairs, plastering or making good after old units and tiles are removed."]}]]}],["$","li","4",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Structural work, such as removing a wall or installing support, where an open-plan layout is proposed."]}]]}],["$","li","5",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Building work outside the kitchen, including pipework alterations, ventilation or changes to doors and windows."]}]]}],["$","li","6",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Delivery charges, parking, difficult access, temporary storage and the cost of supplying or installing appliances."]}]]}]]}],["$","h2",null,{"className":"font-display text-2xl sm:text-3xl font-bold text-gray-900 tracking-tight mt-12 mb-4","children":"Practical ways to control your renovation cost"}],["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["Start with a written brief that separates essentials from upgrades. Decide whether the layout must change, which appliances need replacing and whether you want a complete refit or a visual update. Keeping plumbing and electrical points in their current positions can reduce disruption, although it should not override a poor layout or safety requirement. Obtain itemised quotations that show units, worktops, appliances, preparation, labour, waste removal and any provisional sums."]}],["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["Choose finishes in order of priority rather than trying to make every element premium. For example, you might invest in durable worktops and reliable appliances while selecting simpler handles or splashback tiles. Confirm measurements before ordering, check appliance dimensions carefully and allow time for lead times. A free, no-obligation quote can help turn an initial range into a project-specific budget. BMB Renovation is based at 157 Judge Street, Watford WD24 5AN and serves Watford, Bushey, Rickmansworth, St Albans, Hemel Hempstead, Borehamwood, Harrow, Croxley Green, Luton and Bedford."]}],["$","aside",null,{"className":"my-10 rounded-2xl bg-gradient-to-br from-gray-900 via-gray-800 to-gray-900 p-6 sm:p-8 border border-[#C8A97E]/30","children":[["$","h3",null,{"className":"font-display text-xl sm:text-2xl font-bold text-white tracking-tight mb-2","children":"Get a Free, No-Obligation Quote"}],["$","p",null,{"className":"text-white/70 text-sm sm:text-base leading-relaxed mb-5","children":["BMB Renovation handles kitchens, bathrooms and full home renovations across Watford, Hertfordshire, North London & Bedfordshire — all trades in-house. Tell us about your project today."]}],["$","$L4",null,{"href":"/contact","className":"inline-flex items-center gap-2 px-6 py-3 rounded-full bg-[#C8A97E] text-white text-sm font-bold hover:bg-[#b39668] transition-colors","children":["Get My Free Quote",["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right w-4 h-4","children":[["$","path","1ays0h",{"d":"M5 12h14"}],["$","path","xquz4c",{"d":"m12 5 7 7-7 7"}],"$undefined"]}]]}]]}]]}],["$","section",null,{"className":"mt-14","children":[["$","div",null,{"className":"flex items-center gap-2.5 mb-6","children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle-help w-6 h-6 text-[#C8A97E]","children":[["$","circle","1mglay",{"cx":"12","cy":"12","r":"10"}],["$","path","1u773s",{"d":"M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"}],["$","path","p32p05",{"d":"M12 17h.01"}],"$undefined"]}],["$","h2",null,{"className":"font-display text-2xl sm:text-3xl font-bold text-gray-900 tracking-tight","children":"Frequently 