:"18","height":"18","x":"3","y":"4","rx":"2"}],["$","path","8toen8",{"d":"M3 10h18"}],"$undefined"]}],"30 July 2026",["$","span",null,{"className":"text-white/25","children":"·"}],["$","span",null,{"children":"BMB Renovation"}]]}]]}]}],["$","article",null,{"className":"py-14 sm:py-20 flex-grow bg-gray-50","children":["$","div",null,{"className":"max-w-[800px] mx-auto px-4 sm:px-6","children":["$","div",null,{"className":"bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10","children":[["$","div",null,{"children":[["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["Choosing kitchen fitters in Watford is about more than finding someone who can assemble cabinets. A reliable fitter should help you understand what the project involves, coordinate the different trades and leave you with a kitchen that works properly day to day. Whether you are replacing a tired kitchen in a Watford terrace, updating a family home in North Watford or renovating a larger open-plan space, it pays to compare scope, costs and timescales before booking."]}],["$","h2",null,{"className":"font-display text-2xl sm:text-3xl font-bold text-gray-900 tracking-tight mt-12 mb-4","children":"What does a kitchen fitter in Watford do?"}],["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["Kitchen fitting can range from installing a ready-to-assemble suite in an existing layout to managing a complete renovation. The work may include removing the old kitchen, preparing walls and floors, fitting cabinets and worktops, installing appliances, plumbing sinks and dishwashers, tiling splashbacks, making electrical changes and completing decorating or flooring. Some projects also involve knocking through a wall, moving services or creating a more open-plan layout, which may require additional planning and specialist input."]}],["$","ul",null,{"className":"my-5 space-y-2.5","children":[["$","li","0",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Kitchen removal and preparation of walls, floors and existing services"]}]]}],["$","li","1",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Cabinet, drawer, worktop and appliance installation"]}]]}],["$","li","2",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Plumbing for sinks, taps, washing machines and dishwashers"]}]]}],["$","li","3",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Electrical work for appliances, lighting and sockets, where required"]}]]}],["$","li","4",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Tiling, flooring, carpentry, decorating and finishing work"]}]]}],["$","li","5",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Minor layout changes or wider renovation work, subject to the project requirements"]}]]}]]}],["$","aside",null,{"className":"my-10 rounded-2xl bg-gradient-to-br from-gray-900 via-gray-800 to-gray-900 p-6 sm:p-8 border border-[#C8A97E]/30","children":[["$","h3",null,{"className":"font-display text-xl sm:text-2xl font-bold text-white tracking-tight mb-2","children":"Thinking about your own project?"}],["$","p",null,{"className":"text-white/70 text-sm sm:text-base leading-relaxed mb-5","children":["BMB Renovation covers Watford, Bushey, Rickmansworth, St Albans, Hemel Hempstead and beyond — all trades in-house. Call +44 7775 758 717 or send us a message."]}],["$","$L4",null,{"href":"/contact","className":"inline-flex items-center gap-2 px-6 py-3 rounded-full bg-[#C8A97E] text-white text-sm font-bold hover:bg-[#b39668] transition-colors","children":["Get a Free Quote",["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right w-4 h-4","children":[["$","path","1ays0h",{"d":"M5 12h14"}],["$","path","xquz4c",{"d":"m12 5 7 7-7 7"}],"$undefined"]}]]}]]}],["$","h2",null,{"className":"font-display text-2xl sm:text-3xl font-bold text-gray-900 tracking-tight mt-12 mb-4","children":"Check whether you need fitting or a full kitchen renovation"}],["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["The distinction matters when comparing quotes. If the room is in good condition and the layout is staying the same, a fitting-only service may cover cabinet installation, worktops and appliances. If the kitchen has uneven walls, dated plumbing, damaged flooring or inadequate electrics, the job is more likely to be a renovation. Moving a sink, cooker or dishwasher can add preparation and coordination, while removing a wall may require structural advice and other project considerations."]}],["$","h3",null,{"className":"font-display text-xl sm:text-2xl font-bold text-gray-900 tracking-tight mt-8 mb-3","children":"A useful way to define your project"}],["$","ul",null,{"className":"my-5 space-y-2.5","children":[["$","li","0",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Write down what is staying, such as appliances, flooring or worktops."]}]]}],["$","li","1",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Mark any changes to the layout, including the position of sinks, ovens and sockets."]}]]}],["$","li","2",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Decide whether walls, ceilings, lighting and flooring need to be included."]}]]}],["$","li","3",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["List the finish you expect, from basic cabinet installation to a fully decorated room."]}]]}],["$","li","4",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Ask each fitter to price the same scope so that quotations can be compared fairly."]}]]}]]}],["$","h2",null,{"className":"font-display text-2xl sm:text-3xl font-bold text-gray-900 tracking-tight mt-12 mb-4","children":"How much does kitchen fitting cost in Watford?"}],["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["As a rough guide, fitting labour for a straightforward kitchen may typically be around £2,000 to £6,000, but this varies considerably. A larger renovation involving removal, plumbing, electrics, tiling, flooring and decorating can cost substantially more, before the kitchen units and appliances are included. Bespoke cabinetry, premium worktops, structural changes and difficult access can also increase the total. These are broad guide prices only: every project differs, so get a free, no-obligation quote for accurate pricing."]}],["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["When reviewing a quote, check whether it includes removal and disposal, preparation work, delivery handling, appliance installation, plumbing, electrical work, tiling, flooring and final making-good. Confirm whether VAT applies and ask how changes will be priced if hidden damage or unsuitable existing services are found. A cheaper quote may simply exclude work that another fitter has included. BMB Renovation offers free, no-obligation quotes and provides kitchen fitting and renovation services. You can review the ",["$","$L4","0",{"href":"/kitchen-fitting-watford","className":"text-[#C8A97E] font-medium underline decoration-[#C8A97E]/40 underline-offset-2 hover:decoration-[#C8A97E] transition-colors","children":"kitchen fitting Watford service"}]," to discuss the scope of your project."]}],["$","h2",null,{"className":"font-display text-2xl sm:text-3xl font-bold text-gray-900 tracking-tight mt-12 mb-4","children":"How long does kitchen fitting take?"}],["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["As a general guide, a straightforward installation may take roughly one to two weeks on site, while a full renovation may take several weeks. The overall programme can be longer when design decisions, kitchen manufacturing, delivery and worktop templating are included. Delays can arise if units arrive damaged or incomplete, appliances are unavailable, or old walls and floors need unexpected repair. Ask for a realistic start date, an estimated completion date and a clear explanation of what could affect the programme."]}],["$","h3",null,{"className":"font-display text-xl sm:text-2xl font-bold text-gray-900 tracking-tight mt-8 mb-3","children":"Questions to ask before booking kitchen fitters"}],["$","ul",null,{"className":"my-5 space-y-2.5","children":[["$","li","0",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["What exactly is included in the quotation, and what is excluded?"]}]]}],["$","li","1",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Will you remove and dispose of the existing kitchen?"]}]]}],["$","li","2",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Who will carry out the plumbing, electrical, tiling and cabinet installation?"]}]]}],["$","li","3",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Have you allowed for wall, floor or service preparation?"]}]]}],["$","li","4",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["Who orders the units, worktops and appliances, and who checks the delivery?"]}]]}],["$","li","5",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["How will variations or unexpected work be approved and charged?"]}]]}],["$","li","6",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["What access, parking and protection will you need at my Watford property?"]}]]}],["$","li","7",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["What is the expected working schedule, and who will be my main contact?"]}]]}],["$","li","8",{"className":"flex gap-3 text-gray-700 leading-relaxed","children":[["$","span",null,{"className":"mt-2.5 h-1.5 w-1.5 rounded-full bg-[#C8A97E] flex-shrink-0"}],["$","span",null,{"children":["When will the kitchen be usable if some finishing work remains?"]}]]}]]}],["$","h2",null,{"className":"font-display text-2xl sm:text-3xl font-bold text-gray-900 tracking-tight mt-12 mb-4","children":"Why using one team for several trades can help"}],["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["A kitchen project often involves several connected tasks. If the plumber, electrician, tiler and cabinet installer are booked separately, you may have to manage gaps between trades and resolve disagreements about responsibility. A team that coordinates these parts can make the sequence easier to follow, although the scope should still be recorded clearly in writing. BMB Renovation handles plumbing, tiling, electrical and cabinet installation work in-house. The company is based at 157 Judge Street, Watford WD24 5AN, and serves Watford, Bushey, Rickmansworth, St Albans, Hemel Hempstead, Borehamwood, Harrow, Croxley Green, Luton and Bedford."]}],["$","p",null,{"className":"text-gray-700 leading-relaxed my-5","children":["Before work begins, agree how the room will be protected, where materials will be stored and how waste will be removed. Confirm who disconnects and reconnects appliances, whether water and power will be unavailable at particular times, and how the finished work will be checked. It is also sensible to keep a written record of selections, such as cabinet colours, handles, worktops, tiles and appliances, because small changes can affect both price and lead time. If you are comparing local options, ask for a detailed ",["$","$L4","0",{"href":"/contact","className":"text-[#C8A97E] font-medium underline decoration-[#C8A97E]/40 underline-offset-2 hover:decoration-[#C8A97E] transition-colors","children":"free quote from BMB Renovation"}]," alongside other written quotations rather than relying on a verbal estimate."]}],["$","aside",null,{"className":"my-10 rounded-2xl bg-gradient-to-br from-gray-900 via-gray-800 to-gray-900 p-6 sm:p-8 border border-[#C8A97E]/30","children":[["$","h3",null,{"className":"font-display text-xl sm:text-2xl font-bold text-white tracking-tight mb-2","children":"Get a Free, No-Obligation Quote"}],["$","p",null,{"className":"text-white/70 text-sm sm:text-base leading-relaxed mb-5","children":["BMB Renovation handles kitchens, bathrooms and full home renovations across Watford, Hertfordshire, North London & Bedfordshire — all trades in-house. Tell us about your project today."]}],["$","$L4",null,{"href":"/contact","className":"inline-flex items-center gap-2 px-6 py-3 rounded-full bg-[#C8A97E] text-white text-sm font-bold hover:bg-[#b39668] transition-colors","children":["Get My Free Quote",["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right w-4 h-4","children":[["$","path","1ays0h",{"d":"M5 12h14"}],["$","path","xquz4c",{"d":"m12 5 7 7-7 7"}],"$undefined"]}]]}]]}]]}],["$","section",null,{"className":"mt-14","children":[["$","div",null,{"className":"flex items-center gap-2.5 mb-6","children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle-help w-6 h-6 text-[#C8A97E]","children":[["$","circle","1mglay",{"cx":"12","cy":"12","r":"10"}],["$","path","1u773s",{"d":"M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"}],["$","path","p32p05",{"d":"M12 17h.01"}],"$undefined"]}],["$","h2",null,{"className":"font-di